+bool LastStandStartAvailable(Board* board)
+{
+    return board->mApp->mGameMode == GameMode::GAMEMODE_CHALLENGE_LAST_STAND &&
+        board->mStoreButton != nullptr &&
+        !board->mStoreButton->mBtnNoDraw &&
+        !board->mStoreButton->mDisabled &&
+        board->CanInteractWithBoardButtons();
+}
+
+bool SurvivalRepickAvailable(Board* board)
+{
+    return board->mApp->IsSurvivalMode() &&
+        board->IsSurvivalStageWithRepick() &&
+        board->mLevelComplete;
+}
+
+bool ApplyInteraction(Board* board, std::string_view interaction)
+{
+    if (interaction != "last_stand_start" || !LastStandStartAvailable(board))
+        return false;
+
+    GameButton* button = board->mStoreButton;
+    const int x = button->mX + button->mWidth / 2;
+    const int y = button->mY + button->mHeight / 2;
+    WidgetManager* manager = board->mApp->mWidgetManager;
+    const int previousMouseX = manager->mLastMouseX;
+    const int previousMouseY = manager->mLastMouseY;
+    const Point parentPosition =
+        button->mParentWidget != nullptr
+            ? button->mParentWidget->GetAbsPos()
+            : Point();
+    manager->mLastMouseX = parentPosition.mX + x;
+    manager->mLastMouseY = parentPosition.mY + y;
+    button->Update();
+    board->MouseDown(x, y, 1);
+    board->MouseUp(x, y, 1);
+    manager->mLastMouseX = previousMouseX;
+    manager->mLastMouseY = previousMouseY;
+    button->Update();
+    return true;
+}
