+namespace
+{
+constexpr std::size_t kModHeaderSize = 1084;
+constexpr std::size_t kPatternSize = 64 * 4 * 4;
+
+[[noreturn]] void Fail(const char* theMessage)
+{
+	std::cerr << theMessage << ": " << Mix_GetError() << '\n';
+	std::exit(1);
+}
+
+std::vector<unsigned char> MakeSilentMod()
+{
+	std::vector<unsigned char> aModule(kModHeaderSize + kPatternSize, 0);
+	aModule[950] = 1;  // Song length.
+	aModule[1080] = 'M';
+	aModule[1081] = '.';
+	aModule[1082] = 'K';
+	aModule[1083] = '.';
+
+	// Row zero, channel zero: ProTracker F7D sets the native tempo to 125.
+	aModule[kModHeaderSize + 2] = 0x0F;
+	aModule[kModHeaderSize + 3] = 125;
+	return aModule;
+}
+
+void RequireTempo(Mix_Music* theMusic, double theExpected)
+{
+	const double aTempo = Mix_GetMusicTempo(theMusic);
+	if (std::abs(aTempo - theExpected) > 1.0e-4)
+	{
+		std::cerr << "expected tempo factor " << theExpected
+				  << ", got " << aTempo << '\n';
+		std::exit(1);
+	}
+}
+}
+
+int main()
+{
+	if (MusicTempoFactorForRowDifference(4, 155.0f) >= 1.0 ||
+		MusicTempoFactorForRowDifference(1, 155.0f) >= 1.0 ||
+		MusicTempoFactorForRowDifference(0, 155.0f) != 1.0 ||
+		MusicTempoFactorForRowDifference(-1, 155.0f) <= 1.0 ||
+		MusicTempoFactorForRowDifference(-4, 155.0f) <= 1.0)
+	{
+		std::cerr << "music row-difference tempo correction has the wrong direction\n";
+		return 1;
+	}
+
+	SDL_setenv("SDL_AUDIODRIVER", "dummy", 1);
+	if (SDL_Init(SDL_INIT_AUDIO) != 0)
+		Fail("SDL audio initialization failed");
+	if ((Mix_Init(MIX_INIT_MOD) & MIX_INIT_MOD) == 0)
+		Fail("MOD codec initialization failed");
+	if (Mix_OpenAudio(44100, AUDIO_S16SYS, 2, 1024) != 0)
+		Fail("audio mixer initialization failed");
+
+	std::vector<unsigned char> aModule = MakeSilentMod();
+	SDL_RWops* aStream = SDL_RWFromConstMem(
+		aModule.data(),
+		static_cast<int>(aModule.size()));
+	if (aStream == nullptr)
+		Fail("module stream creation failed");
+	Mix_Music* aMusic = Mix_LoadMUS_RW(aStream, 1);
+	if (aMusic == nullptr)
+		Fail("synthetic MOD load failed");
+
+	RequireTempo(aMusic, 1.0);
+	if (Mix_SetMusicTempo(aMusic, 0.98) != 0)
+		Fail("slower tempo factor failed");
+	RequireTempo(aMusic, 0.98);
+	if (Mix_SetMusicTempo(aMusic, 1.02) != 0)
+		Fail("faster tempo factor failed");
+	RequireTempo(aMusic, 1.02);
+	if (Mix_SetMusicTempo(aMusic, 1.0) != 0)
+		Fail("tempo reset failed");
+	RequireTempo(aMusic, 1.0);
+
+	Mix_FreeMusic(aMusic);
+	Mix_CloseAudio();
+	Mix_Quit();
+	SDL_Quit();
+	std::cout << "OpenMPT tempo-factor regression passed\n";
+	return 0;
+}
