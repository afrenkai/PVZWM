+void ProtocolLine(const std::string& json)
+{
+    std::cout << "PVZWM " << json << '\n' << std::flush;
+}
+
+int TotalZombieHealth(Board* board)
+{
+    int total = 0;
+    Zombie* zombie = nullptr;
+    while (board->IterateZombies(zombie))
+    {
+        if (!zombie->mDead)
+            total += std::max(0, zombie->mBodyHealth) + std::max(0, zombie->mHelmHealth) + std::max(0, zombie->mShieldHealth);
+    }
+    return total;
+}
+
+int ActiveZombieCount(Board* board)
+{
+    int count = 0;
+    Zombie* zombie = nullptr;
+    while (board->IterateZombies(zombie))
+        count += !zombie->mDead;
+    return count;
+}
+
+int ActiveCoinCount(Board* board)
+{
+    int count = 0;
+    Coin* coin = nullptr;
+    while (board->IterateCoins(coin))
+        count += !coin->mDead;
+    return count;
+}
+
+bool HasCollectibleCoin(Board* board)
+{
+    Coin* coin = nullptr;
+    while (board->IterateCoins(coin))
+    {
+        if (!coin->mDead && !coin->mIsBeingCollected)
+            return true;
+    }
+    return false;
+}
+
+bool HasPlantAt(Board* board, int col, int row)
+{
+    Plant* plant = nullptr;
+    while (board->IteratePlants(plant))
+    {
+        if (!plant->mDead && plant->mPlantCol == col && plant->mRow == row)
+            return true;
+    }
+    return false;
+}
+
+void RemoveAllMowers(Board* board)
+{
+    board->mBonusLawnMowersRemaining = 0;
+    std::vector<LawnMower*> mowers;
+    LawnMower* mower = nullptr;
+    while (board->IterateLawnMowers(mower))
+        mowers.push_back(mower);
+    for (LawnMower* current : mowers)
+    {
+        if (!current->mDead)
+            current->Die();
+    }
+    board->ProcessDeleteQueue();
+}
+
+std::vector<int> LegalActions(Board* board)
+{
+    std::vector<int> legal{kWaitAction};
+    const int rows = board->StageHas6Rows() ? 6 : 5;
+
+    for (int slot = 0; slot < board->mSeedBank->mNumPackets && slot < kSeedSlots; ++slot)
+    {
+        SeedPacket& packet = board->mSeedBank->mSeedPackets[slot];
+        if (!packet.CanPickUp())
+            continue;
+        SeedType seedType = packet.mPacketType == SeedType::SEED_IMITATER ? packet.mImitaterType : packet.mPacketType;
+        for (int row = 0; row < rows; ++row)
+        {
+            for (int col = 0; col < kCols; ++col)
+            {
+                if (board->CanPlantAt(col, row, seedType) == PlantingReason::PLANTING_OK)
+                    legal.push_back(kPlantActionBegin + slot * kCells + row * kCols + col);
+            }
+        }
+    }
+
+    if (board->mShowShovel)
+    {
+        for (int row = 0; row < rows; ++row)
+        {
+            for (int col = 0; col < kCols; ++col)
+            {
+                if (HasPlantAt(board, col, row))
+                    legal.push_back(kShovelActionBegin + row * kCols + col);
+            }
+        }
+    }
+
+    if (board->mApp->IsWhackAZombieLevel() || board->mApp->IsScaryPotterLevel())
+    {
+        for (int row = 0; row < rows; ++row)
+        {
+            for (int col = 0; col < kCols; ++col)
+                legal.push_back(kBoardClickActionBegin + row * kCols + col);
+        }
+    }
+    if (HasCollectibleCoin(board))
+        legal.push_back(kCollectAction);
+    return legal;
+}
+
+std::string ObservationJson(
+    LawnApp* app,
+    int action,
+    int ticks,
+    int healthBefore,
+    int frameWidth = 0,
+    int frameHeight = 0)
+{
+    Board* board = app->mBoard;
+    if (board == nullptr)
+        return "{\"ok\":false,\"error\":\"board unavailable\"}";
+
+    const int healthAfter = TotalZombieHealth(board);
+    const bool won = app->mBoardResult == BoardResult::BOARDRESULT_WON;
+    const bool lost = app->mBoardResult == BoardResult::BOARDRESULT_LOST;
+    const double reward = (healthBefore < 0 ? 0.0 : static_cast<double>(healthBefore - healthAfter) / 1000.0)
+        + (won ? 100.0 : 0.0) - (lost ? 100.0 : 0.0);
+
+    std::ostringstream out;
+    out << "{\"ok\":true"
+        << ",\"protocol_version\":3"
+        << ",\"action_count\":" << kActionCount
+        << ",\"logical_width\":" << BOARD_WIDTH
+        << ",\"logical_height\":" << BOARD_HEIGHT
+        << ",\"level\":" << board->mLevel
+        << ",\"area\":" << ((board->mLevel - 1) / LEVELS_PER_AREA + 1)
+        << ",\"stage\":" << ((board->mLevel - 1) % LEVELS_PER_AREA + 1)
+        << ",\"scene\":" << static_cast<int>(app->mGameScene)
+        << ",\"board_result\":" << static_cast<int>(app->mBoardResult)
+        << ",\"done\":" << ((won || lost) ? "true" : "false")
+        << ",\"won\":" << (won ? "true" : "false")
+        << ",\"reward\":" << reward
+        << ",\"last_action\":" << action
+        << ",\"ticks\":" << ticks
+        << ",\"sun\":" << board->mSunMoney
+        << ",\"wave\":" << board->mCurrentWave
+        << ",\"plants_count\":" << board->mPlants.mSize
+        << ",\"zombies_count\":" << ActiveZombieCount(board)
+        << ",\"coins_count\":" << ActiveCoinCount(board)
+        << ",\"main_counter\":" << board->mMainCounter
+        << ",\"tutorial_state\":" << static_cast<int>(board->mTutorialState)
+        << ",\"zombie_countdown\":" << board->mZombieCountDown
+        << ",\"num_waves\":" << board->mNumWaves
+        << ",\"total_spawned_waves\":" << board->mTotalSpawnedWaves
+        << ",\"level_complete\":" << (board->mLevelComplete ? "true" : "false")
+        << ",\"zombie_health\":" << healthAfter
+        << ",\"mowers_ready\":" << board->CountUntriggerLawnMowers()
+        << ",\"mowers_triggered\":" << board->mTriggeredLawnMowers
+        << ",\"seed_bank_capacity\":" << board->mSeedBank->mNumPackets;
+
+    out << ",\"available_seed_types\":[";
+    bool firstAvailableSeed = true;
+    for (int raw = static_cast<int>(SeedType::SEED_PEASHOOTER);
+         raw < static_cast<int>(SeedType::SEED_IMITATER);
+         ++raw)
+    {
+        if (!app->HasSeedType(static_cast<SeedType>(raw)))
+            continue;
+        if (!firstAvailableSeed)
+            out << ',';
+        firstAvailableSeed = false;
+        out << raw;
+    }
+    out << ']';
+
+    out << ",\"seed_packets\":[";
+    for (int slot = 0; slot < board->mSeedBank->mNumPackets; ++slot)
+    {
+        if (slot > 0)
+            out << ',';
+        SeedPacket& packet = board->mSeedBank->mSeedPackets[slot];
+        out << "{\"slot\":" << slot
+            << ",\"type\":" << static_cast<int>(packet.mPacketType)
+            << ",\"active\":" << (packet.mActive ? "true" : "false")
+            << ",\"refresh\":" << packet.mRefreshCounter << '}';
+    }
+    out << ']';
+
+    out << ",\"plants\":[";
+    bool first = true;
+    Plant* plant = nullptr;
+    while (board->IteratePlants(plant))
+    {
+        if (plant->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(plant->mSeedType)
+            << ",\"row\":" << plant->mRow
+            << ",\"col\":" << plant->mPlantCol
+            << ",\"health\":" << plant->mPlantHealth
+            << ",\"state\":" << static_cast<int>(plant->mState) << '}';
+    }
+    out << ']';
+
+    out << ",\"zombies\":[";
+    first = true;
+    Zombie* zombie = nullptr;
+    while (board->IterateZombies(zombie))
+    {
+        if (zombie->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(zombie->mZombieType)
+            << ",\"row\":" << zombie->mRow
+            << ",\"x\":" << zombie->mPosX
+            << ",\"y\":" << zombie->mPosY
+            << ",\"body_health\":" << zombie->mBodyHealth
+            << ",\"helm_health\":" << zombie->mHelmHealth
+            << ",\"shield_health\":" << zombie->mShieldHealth
+            << ",\"phase\":" << static_cast<int>(zombie->mZombiePhase) << '}';
+    }
+    out << ']';
+
+    out << ",\"mowers\":[";
+    first = true;
+    LawnMower* mower = nullptr;
+    while (board->IterateLawnMowers(mower))
+    {
+        if (mower->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"row\":" << mower->mRow
+            << ",\"state\":" << static_cast<int>(mower->mMowerState)
+            << ",\"type\":" << static_cast<int>(mower->mMowerType)
+            << ",\"x\":" << mower->mPosX
+            << ",\"visible\":" << (mower->mVisible ? "true" : "false") << '}';
+    }
+    out << ']';
+
+    out << ",\"legal_actions\":[";
+    const std::vector<int> legal = LegalActions(board);
+    for (std::size_t i = 0; i < legal.size(); ++i)
+    {
+        if (i > 0)
+            out << ',';
+        out << legal[i];
+    }
+    out << ']';
+    out << FrameJson(app, frameWidth, frameHeight);
+    out << '}';
+    return out.str();
+}
+
+void CollectAll(Board* board)
+{
+    Coin* coin = nullptr;
+    while (board->IterateCoins(coin))
+    {
+        if (!coin->mDead && !coin->mIsBeingCollected)
+            coin->MouseDown(static_cast<int>(coin->mPosX), static_cast<int>(coin->mPosY), 1);
+    }
+}
+
+void ApplyAction(Board* board, int action)
+{
+    if (action == kWaitAction)
+        return;
+
+    if (action >= kPlantActionBegin && action < kShovelActionBegin)
+    {
+        const int offset = action - kPlantActionBegin;
+        const int slot = offset / kCells;
+        const int cell = offset % kCells;
+        const int row = cell / kCols;
+        const int col = cell % kCols;
+        if (slot < board->mSeedBank->mNumPackets)
+        {
+            board->mSeedBank->mSeedPackets[slot].MouseDown(0, 0, 1);
+            board->MouseDown(board->GridToPixelX(col, row) + 40, board->GridToPixelY(col, row) + 40, 1);
+        }
+        return;
+    }
+
+    if (action >= kShovelActionBegin && action < kBoardClickActionBegin)
+    {
+        const int cell = action - kShovelActionBegin;
+        const int row = cell / kCols;
+        const int col = cell % kCols;
+        board->PickUpTool(GameObjectType::OBJECT_TYPE_SHOVEL);
+        board->MouseDown(board->GridToPixelX(col, row) + 40, board->GridToPixelY(col, row) + 40, 1);
+        return;
+    }
+
+    if (action >= kBoardClickActionBegin && action < kCollectAction)
+    {
+        const int cell = action - kBoardClickActionBegin;
+        const int row = cell / kCols;
+        const int col = cell % kCols;
+        board->MouseDown(board->GridToPixelX(col, row) + 40, board->GridToPixelY(col, row) + 40, 1);
+        return;
+    }
+
+    if (action == kCollectAction)
+        CollectAll(board);
+}
+
+void UpdateEngineTick(LawnApp* app)
+{
+    ++app->mAppCounter;
+    app->mBoard->ProcessDeleteQueue();
+    if (app->mLoadingThreadCompleted && app->mEffectSystem != nullptr)
+        app->mEffectSystem->ProcessDeleteQueue();
+    app->mBoard->Update();
+    app->mMusic->MusicUpdate();
+}
+
+bool PickSeeds(LawnApp* app, SeedChooserScreen* chooser, const std::optional<std::vector<int>>& requestedSeeds)
+{
+    std::vector<SeedType> candidates;
+    Board* board = app->mBoard;
+    if (requestedSeeds.has_value())
+    {
+        if (static_cast<int>(requestedSeeds->size()) != board->mSeedBank->mNumPackets)
+            return false;
+        for (int raw : *requestedSeeds)
+        {
+            if (raw < static_cast<int>(SeedType::SEED_PEASHOOTER) ||
+                raw >= static_cast<int>(SeedType::SEED_IMITATER))
+                return false;
+            const SeedType seedType = static_cast<SeedType>(raw);
+            if (std::find(candidates.begin(), candidates.end(), seedType) != candidates.end())
+                return false;
+            candidates.push_back(seedType);
+        }
+    }
+    else
+    {
+        if (board->StageHasRoof())
+            candidates.push_back(SeedType::SEED_FLOWERPOT);
+        if (board->StageHasPool())
+            candidates.push_back(SeedType::SEED_LILYPAD);
+        if (board->StageIsNight())
+        {
+            candidates.push_back(SeedType::SEED_SUNSHROOM);
+            candidates.push_back(SeedType::SEED_PUFFSHROOM);
+            candidates.push_back(SeedType::SEED_FUMESHROOM);
+            candidates.push_back(SeedType::SEED_GRAVEBUSTER);
+        }
+        else
+        {
+            candidates.push_back(SeedType::SEED_SUNFLOWER);
+            candidates.push_back(SeedType::SEED_PEASHOOTER);
+            candidates.push_back(SeedType::SEED_REPEATER);
+            candidates.push_back(SeedType::SEED_SNOWPEA);
+        }
+        candidates.insert(candidates.end(), {
+            SeedType::SEED_WALLNUT,
+            SeedType::SEED_POTATOMINE,
+            SeedType::SEED_CHERRYBOMB,
+            SeedType::SEED_SQUASH,
+            SeedType::SEED_JALAPENO,
+            SeedType::SEED_CABBAGEPULT,
+            SeedType::SEED_KERNELPULT,
+            SeedType::SEED_MELONPULT,
+            SeedType::SEED_TALLNUT,
+            SeedType::SEED_BLOVER,
+            SeedType::SEED_CACTUS,
+        });
+    }
+
+    const int targetCount = board->mSeedBank->mNumPackets;
+    auto choose = [&](SeedType seedType)
+    {
+        if (chooser->mSeedsInBank >= targetCount || !app->HasSeedType(seedType))
+            return false;
+        ChosenSeed& chosen = chooser->mChosenSeeds[seedType];
+        if (chosen.mSeedState != ChosenSeedState::SEED_IN_CHOOSER || chooser->SeedNotAllowedToPick(seedType))
+            return false;
+        const int slot = chooser->mSeedsInBank;
+        chosen.mTimeStartMotion = 0;
+        chosen.mTimeEndMotion = 0;
+        chosen.mStartX = chosen.mX;
+        chosen.mStartY = chosen.mY;
+        chooser->GetSeedPositionInBank(slot, chosen.mEndX, chosen.mEndY);
+        chosen.mX = chosen.mEndX;
+        chosen.mY = chosen.mEndY;
+        chosen.mSeedState = ChosenSeedState::SEED_IN_BANK;
+        chosen.mSeedIndexInBank = slot;
+        ++chooser->mSeedsInBank;
+        return true;
+    };
+
+    for (SeedType seedType : candidates)
+    {
+        if (!choose(seedType) && requestedSeeds.has_value())
+            return false;
+    }
+    if (!requestedSeeds.has_value())
+    {
+        for (int raw = static_cast<int>(SeedType::SEED_PEASHOOTER);
+             raw < static_cast<int>(SeedType::NUM_SEEDS_IN_CHOOSER) && chooser->mSeedsInBank < targetCount;
+             ++raw)
+            choose(static_cast<SeedType>(raw));
+    }
+    if (chooser->mSeedsInBank != targetCount)
+        return false;
+    chooser->CloseSeedChooser();
+    return true;
+}
+
+bool ResetLevel(
+    LawnApp* app,
+    int level,
+    int seed,
+    bool disableMowers,
+    const std::optional<std::vector<int>>& requestedSeeds)
+{
+    if (level < 1 || level > FINAL_LEVEL || app->mPlayerInfo == nullptr)
+        return false;
+
+    app->mAppRandSeed = seed;
+    app->mRandSeed = static_cast<uint32_t>(seed);
+    SRand(static_cast<uint32_t>(seed));
+    std::srand(static_cast<unsigned int>(seed));
+    app->mPlayerInfo->SetLevel(level);
+    app->mGameMode = GameMode::GAMEMODE_ADVENTURE;
+    app->mMusic->mMusicDisabled = true;
+    app->MakeNewBoard();
+    app->mBoard->InitLevel();
+    app->mBoard->mCutScene->PreloadResources();
+    app->mBoard->mCutScene->PlaceLawnItems();
+    app->mBoard->RemoveCutsceneZombies();
+    if (app->IsFinalBossLevel())
+        app->mBoard->mChallenge->PlayBossEnter();
+    app->mBoard->ProcessDeleteQueue();
+    app->mBoardResult = BoardResult::BOARDRESULT_NONE;
+    app->mGameScene = GameScenes::SCENE_LEVEL_INTRO;
+    app->ShowSeedChooserScreen();
+    if (app->mBoard == nullptr)
+        return false;
+
+    if (app->mSeedChooserScreen != nullptr && app->mBoard->ChooseSeedsOnCurrentLevel() &&
+        !PickSeeds(app, app->mSeedChooserScreen, requestedSeeds))
+        return false;
+    app->StartPlaying();
+    UpdateEngineTick(app);
+    if (disableMowers)
+        RemoveAllMowers(app->mBoard);
+    return true;
+}
+}
