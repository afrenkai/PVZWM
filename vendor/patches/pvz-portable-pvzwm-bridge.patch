+void SexyAppBase::FinishDemoPlayback()
+{
+	if (mUpdateCount != mDemoExpectedUpdateCount)
+	{
+		WriteDemoPlaybackReport("length_mismatch");
+		Sexy::LogError(
+			"Demo playback ended at update %u; expected update %u.",
+			mUpdateCount, mDemoExpectedUpdateCount);
+		DoExit(1);
+	}
+	WriteDemoPlaybackReport("complete");
+	Sexy::PrintF(
+		"Demo playback completed at update %u.\n",
+		mUpdateCount);
+	Shutdown();
+}
+
+void SexyAppBase::FinishDemoPlaybackAtTarget()
+{
+	WriteDemoPlaybackReport("target_reached");
+	Sexy::PrintF(
+		"Demo playback reached verification target %u.\n",
+		mDemoVerificationTarget);
+	Shutdown();
+}
+
+void SexyAppBase::WriteDemoPlaybackReport(const char* theStatus)
+{
+	if (mDemoReportPath.empty())
+		return;
+
+	std::ofstream aReport(PathFromU8(mDemoReportPath), std::ios::out | std::ios::trunc);
+	aReport
+		<< "{\n"
+		<< "  \"schema_version\": 1,\n"
+		<< "  \"status\": \"" << theStatus << "\",\n"
+		<< "  \"actual_update\": " << mUpdateCount << ",\n"
+		<< "  \"expected_update\": " << mDemoExpectedUpdateCount << ",\n"
+		<< "  \"verification_target\": " << mDemoVerificationTarget << "\n"
+		<< "}\n";
+}
