+bool GLInterface::CreateImageTexture(MemoryImage* image)
+{
+	bool purgeBits = false;
+	if (!image->mRenderData)
+	{
+		image->mRenderData = new TextureData();
+		purgeBits = image->mPurgeBits;
+		std::scoped_lock lock(mCritSect);
+		mImageSet.insert(image);
+	}
+	TextureData* data = static_cast<TextureData*>(image->mRenderData);
+	data->CheckCreateTextures(image);
+	if (purgeBits)
+		image->PurgeBits();
+	return data->mPixelFormat != PixelFormat_Unknown;
+}
+
+bool GLInterface::RecoverBits(MemoryImage* image)
+{
+	if (!image->mRenderData)
+		return false;
+	TextureData* data = static_cast<TextureData*>(image->mRenderData);
+	if (data->mBitsChangedCount != image->mBitsChangedCount
+		|| data->mCpuBits.size()
+			!= static_cast<size_t>(image->mWidth) * image->mHeight)
+	{
+		return false;
+	}
+	std::memcpy(
+		image->mBits,
+		data->mCpuBits.data(),
+		data->mCpuBits.size() * sizeof(uint32_t));
+	return true;
+}
+
+void GLInterface::PushTransform(const SexyMatrix3& transform, bool concatenate)
+{
+	if (mTransformStack.empty() || !concatenate)
+		mTransformStack.push_back(transform);
+	else
+		mTransformStack.push_back(transform * mTransformStack.back());
+}
+
+void GLInterface::PopTransform()
+{
+	if (!mTransformStack.empty())
+		mTransformStack.pop_back();
+}
+
+void GLInterface::Blt(
+	Image* image,
+	float x,
+	float y,
+	const Rect& sourceRect,
+	const Color& color,
+	int drawMode,
+	bool linearFilter)
+{
+	if (!mTransformStack.empty())
+	{
+		BltClipF(
+			image,
+			x,
+			y,
+			sourceRect,
+			nullptr,
+			color,
+			drawMode,
+			linearFilter);
+		return;
+	}
+	if (!PreDraw())
+		return;
+	MemoryImage* memoryImage = static_cast<MemoryImage*>(image);
+	if (!CreateImageTexture(memoryImage))
+		return;
+	SetDrawMode(drawMode);
+	gLinearFilter = linearFilter;
+	static_cast<TextureData*>(memoryImage->mRenderData)->Blt(
+		x,
+		y,
+		sourceRect,
+		color);
+}
+
+void GLInterface::BltClipF(
+	Image* image,
+	float x,
+	float y,
+	const Rect& sourceRect,
+	const Rect* clipRect,
+	const Color& color,
+	int drawMode,
+	bool linearFilter)
+{
+	SexyTransform2D transform;
+	transform.Translate(x, y);
+	BltTransformed(
+		image,
+		clipRect,
+		color,
+		drawMode,
+		sourceRect,
+		transform,
+		linearFilter);
+}
+
+void GLInterface::BltMirror(
+	Image* image,
+	float x,
+	float y,
+	const Rect& sourceRect,
+	const Color& color,
+	int drawMode,
+	bool linearFilter)
+{
+	SexyTransform2D transform;
+	transform.Translate(-sourceRect.mWidth, 0);
+	transform.Scale(-1, 1);
+	transform.Translate(x, y);
+	BltTransformed(
+		image,
+		nullptr,
+		color,
+		drawMode,
+		sourceRect,
+		transform,
+		linearFilter);
+}
+
+void GLInterface::StretchBlt(
+	Image* image,
+	const Rect& destinationRect,
+	const Rect& sourceRect,
+	const Rect* clipRect,
+	const Color& color,
+	int drawMode,
+	bool fastStretch,
+	bool mirror)
+{
+	float scaleX =
+		static_cast<float>(destinationRect.mWidth) / sourceRect.mWidth;
+	float scaleY =
+		static_cast<float>(destinationRect.mHeight) / sourceRect.mHeight;
+	SexyTransform2D transform;
+	if (mirror)
+	{
+		transform.Translate(-sourceRect.mWidth, 0);
+		transform.Scale(-scaleX, scaleY);
+	}
+	else
+	{
+		transform.Scale(scaleX, scaleY);
+	}
+	transform.Translate(destinationRect.mX, destinationRect.mY);
+	BltTransformed(
+		image,
+		clipRect,
+		color,
+		drawMode,
+		sourceRect,
+		transform,
+		!fastStretch);
+}
+
+void GLInterface::BltRotated(
+	Image* image,
+	float x,
+	float y,
+	const Rect* clipRect,
+	const Color& color,
+	int drawMode,
+	double rotation,
+	float rotationCenterX,
+	float rotationCenterY,
+	const Rect& sourceRect)
+{
+	SexyTransform2D transform;
+	transform.Translate(-rotationCenterX, -rotationCenterY);
+	transform.RotateRad(rotation);
+	transform.Translate(x + rotationCenterX, y + rotationCenterY);
+	BltTransformed(
+		image,
+		clipRect,
+		color,
+		drawMode,
+		sourceRect,
+		transform,
+		true);
+}
+
+void GLInterface::BltTransformed(
+	Image* image,
+	const Rect* clipRect,
+	const Color& color,
+	int drawMode,
+	const Rect& sourceRect,
+	const SexyMatrix3& transform,
+	bool linearFilter,
+	float x,
+	float y,
+	bool center)
+{
+	if (!PreDraw())
+		return;
+	MemoryImage* memoryImage = static_cast<MemoryImage*>(image);
+	if (!CreateImageTexture(memoryImage))
+		return;
+	SetDrawMode(drawMode);
+	gLinearFilter = linearFilter;
+	TextureData* data = static_cast<TextureData*>(memoryImage->mRenderData);
+
+	if (!mTransformStack.empty())
+	{
+		if (x != 0 || y != 0)
+		{
+			SexyTransform2D combined;
+			if (center)
+				combined.Translate(-sourceRect.mWidth / 2.0f, -sourceRect.mHeight / 2.0f);
+			combined = transform * combined;
+			combined.Translate(x, y);
+			combined = mTransformStack.back() * combined;
+			data->BltTransformed(combined, sourceRect, color, clipRect);
+		}
+		else
+		{
+			SexyTransform2D combined = mTransformStack.back() * transform;
+			data->BltTransformed(
+				combined,
+				sourceRect,
+				color,
+				clipRect,
+				x,
+				y,
+				center);
+		}
+	}
+	else
+	{
+		data->BltTransformed(
+			transform,
+			sourceRect,
+			color,
+			clipRect,
+			x,
+			y,
+			center);
+	}
+}
+
+void GLInterface::DrawLine(
+	double startX,
+	double startY,
+	double endX,
+	double endY,
+	const Color& color,
+	int drawMode)
+{
+	if (!PreDraw())
+		return;
+	SetDrawMode(drawMode);
+	SexyVector2 start(startX, startY);
+	SexyVector2 end(endX, endY);
+	if (!mTransformStack.empty())
+	{
+		start = mTransformStack.back() * start;
+		end = mTransformStack.back() * end;
+	}
+	SDL_SetRenderDrawColor(
+		gRenderer,
+		static_cast<Uint8>(color.mRed),
+		static_cast<Uint8>(color.mGreen),
+		static_cast<Uint8>(color.mBlue),
+		static_cast<Uint8>(color.mAlpha));
+	SDL_RenderDrawLineF(gRenderer, start.x, start.y, end.x, end.y);
+}
+
+void GLInterface::FillRect(
+	const Rect& rect,
+	const Color& color,
+	int drawMode)
+{
+	if (!PreDraw())
+		return;
+	SetDrawMode(drawMode);
+	float x = rect.mX;
+	float y = rect.mY;
+	float width = rect.mWidth;
+	float height = rect.mHeight;
+	uint32_t packedColor = color.ToGLColor();
+	GLVertex vertices[4] = {
+		{x, y, 0, packedColor, 0, 0},
+		{x, y + height, 0, packedColor, 0, 0},
+		{x + width, y, 0, packedColor, 0, 0},
+		{x + width, y + height, 0, packedColor, 0, 0}
+	};
+	if (!mTransformStack.empty())
+	{
+		for (auto& vertex : vertices)
+		{
+			SexyVector2 point(vertex.sx, vertex.sy);
+			point = mTransformStack.back() * point;
+			vertex.sx = point.x;
+			vertex.sy = point.y;
+		}
+	}
+	RenderVertices(nullptr, vertices, 4, Primitive::TriangleStrip);
+}
+
+void GLInterface::DrawTriangle(
+	const TriVertex& first,
+	const TriVertex& second,
+	const TriVertex& third,
+	const Color& color,
+	int drawMode)
+{
+	if (!PreDraw())
+		return;
+	SetDrawMode(drawMode);
+	uint32_t packedColor = color.ToGLColor();
+	GLVertex vertices[3] = {
+		{first.x, first.y, 0, VertexColor(first.color, packedColor), 0, 0},
+		{second.x, second.y, 0, VertexColor(second.color, packedColor), 0, 0},
+		{third.x, third.y, 0, VertexColor(third.color, packedColor), 0, 0}
+	};
+	RenderVertices(nullptr, vertices, 3, Primitive::Triangles);
+}
+
+void GLInterface::DrawTriangleTex(
+	const TriVertex& first,
+	const TriVertex& second,
+	const TriVertex& third,
+	const Color& color,
+	int drawMode,
+	Image* texture,
+	bool blend)
+{
+	TriVertex vertices[1][3] = {{first, second, third}};
+	DrawTrianglesTex(vertices, 1, color, drawMode, texture, 0, 0, blend);
+}
+
+void GLInterface::DrawTrianglesTex(
+	const TriVertex vertices[][3],
+	int triangleCount,
+	const Color& color,
+	int drawMode,
+	Image* texture,
+	float translateX,
+	float translateY,
+	bool blend)
+{
+	if (!PreDraw())
+		return;
+	MemoryImage* memoryImage = static_cast<MemoryImage*>(texture);
+	if (!CreateImageTexture(memoryImage))
+		return;
+	SetDrawMode(drawMode);
+	gLinearFilter = blend;
+	bool clampUv =
+		(memoryImage->mRenderFlags & RenderImageFlag_Repeat) == 0;
+	static_cast<TextureData*>(memoryImage->mRenderData)->BltTriangles(
+		vertices,
+		triangleCount,
+		color.ToGLColor(),
+		translateX,
+		translateY,
+		clampUv);
+}
+
+void GLInterface::DrawTrianglesTexStrip(
+	const TriVertex vertices[],
+	int triangleCount,
+	const Color& color,
+	int drawMode,
+	Image* texture,
+	float translateX,
+	float translateY,
+	bool blend)
+{
+	TriVertex batch[100][3];
+	int completed = 0;
+	while (completed < triangleCount)
+	{
+		int count = std::min(100, triangleCount - completed);
+		for (int index = 0; index < count; ++index)
+		{
+			batch[index][0] = vertices[completed];
+			batch[index][1] = vertices[completed + 1];
+			batch[index][2] = vertices[completed + 2];
+			++completed;
+		}
+		DrawTrianglesTex(
+			batch,
+			count,
+			color,
+			drawMode,
+			texture,
+			translateX,
+			translateY,
+			blend);
+	}
+}
+
+void GLInterface::FillPoly(
+	const Point vertices[],
+	int vertexCount,
+	const Rect* clipRect,
+	const Color& color,
+	int drawMode,
+	int translateX,
+	int translateY)
+{
+	if (vertexCount < 3 || !PreDraw())
+		return;
+	SetDrawMode(drawMode);
+	uint32_t packedColor = color.ToGLColor();
+	VertexList output;
+	output.reserve(vertexCount);
+	for (int index = 0; index < vertexCount; ++index)
+	{
+		GLVertex vertex{
+			vertices[index].mX + static_cast<float>(translateX),
+			vertices[index].mY + static_cast<float>(translateY),
+			0,
+			packedColor,
+			0,
+			0
+		};
+		if (!mTransformStack.empty())
+		{
+			SexyVector2 point(vertex.sx, vertex.sy);
+			point = mTransformStack.back() * point;
+			vertex.sx = point.x;
+			vertex.sy = point.y;
+		}
+		output.push_back(vertex);
+	}
+	ScopedClipRect clip(clipRect);
+	RenderVertices(nullptr, output, Primitive::TriangleFan);
+}
