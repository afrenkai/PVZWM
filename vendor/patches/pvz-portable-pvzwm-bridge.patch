+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#ifndef __MUSIC_TEMPO_H__
+#define __MUSIC_TEMPO_H__
+
+inline double MusicTempoFactorForRowDifference(
+	int theRowDifference,
+	float theBaseBPM)
+{
+	if (theBaseBPM <= 0.0f)
+		return 1.0;
+
+	int aBPM = static_cast<int>(theBaseBPM);
+	if (theRowDifference > 2)
+		aBPM -= 2;
+	else if (theRowDifference > 0)
+		aBPM -= 1;
+	else if (theRowDifference < -2)
+		aBPM += 2;
+	else if (theRowDifference < 0)
+		aBPM += 1;
+	return static_cast<double>(aBPM) / theBaseBPM;
+}
+
+#endif
