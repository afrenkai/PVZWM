+std::optional<int> JsonInt(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find(':', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    ++pos;
+    while (pos < line.size() && std::isspace(static_cast<unsigned char>(line[pos])))
+        ++pos;
+    std::size_t end = pos;
+    if (end < line.size() && (line[end] == '-' || line[end] == '+'))
+        ++end;
+    while (end < line.size() && std::isdigit(static_cast<unsigned char>(line[end])))
+        ++end;
+    if (end == pos)
+        return std::nullopt;
+    return std::stoi(std::string(line.substr(pos, end - pos)));
+}
+
+std::optional<std::vector<int>> JsonIntArray(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find('[', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    const std::size_t close = line.find(']', pos + 1);
+    if (close == std::string_view::npos)
+        return std::nullopt;
+
+    std::vector<int> values;
+    ++pos;
+    while (pos < close)
+    {
+        while (pos < close && (std::isspace(static_cast<unsigned char>(line[pos])) || line[pos] == ','))
+            ++pos;
+        if (pos >= close)
+            break;
+        std::size_t end = pos;
+        if (line[end] == '-' || line[end] == '+')
+            ++end;
+        while (end < close && std::isdigit(static_cast<unsigned char>(line[end])))
+            ++end;
+        if (end == pos || (end == pos + 1 && (line[pos] == '-' || line[pos] == '+')))
+            return std::nullopt;
+        values.push_back(std::stoi(std::string(line.substr(pos, end - pos))));
+        pos = end;
+    }
+    return values;
+}
+
+std::optional<std::string> JsonString(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find(':', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find('"', pos + 1);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    const std::size_t end = line.find('"', pos + 1);
+    if (end == std::string_view::npos)
+        return std::nullopt;
+    return std::string(line.substr(pos + 1, end - pos - 1));
+}
