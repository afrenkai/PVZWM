+std::string FrameJson(LawnApp* app, int outputWidth, int outputHeight)
+{
+    if (outputWidth <= 0 || outputHeight <= 0)
+        return "";
+
+    outputWidth = std::clamp(outputWidth, 1, BOARD_WIDTH);
+    outputHeight = std::clamp(outputHeight, 1, BOARD_HEIGHT);
+    std::vector<unsigned char> rgba(
+        static_cast<std::size_t>(BOARD_WIDTH) * BOARD_HEIGHT * 4);
+
+#if defined(PVZ_MACOS_METAL)
+    SDL_Renderer* renderer = static_cast<SDL_Renderer*>(app->mContext);
+    if (renderer == nullptr)
+        return "";
+
+    static SDL_Texture* target = nullptr;
+    if (target == nullptr)
+    {
+        target = SDL_CreateTexture(
+            renderer,
+            SDL_PIXELFORMAT_RGBA32,
+            SDL_TEXTUREACCESS_TARGET,
+            BOARD_WIDTH,
+            BOARD_HEIGHT);
+        if (target == nullptr)
+            return "";
+    }
+
+    SDL_Texture* previousTarget = SDL_GetRenderTarget(renderer);
+    if (SDL_SetRenderTarget(renderer, target) != 0)
+        return "";
+    SDL_RenderSetClipRect(renderer, nullptr);
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    SDL_RenderClear(renderer);
+
+    Graphics graphics(app->mGLInterface->GetScreenImage());
+    app->mBoard->Draw(&graphics);
+    const int readResult = SDL_RenderReadPixels(
+        renderer,
+        nullptr,
+        SDL_PIXELFORMAT_RGBA32,
+        rgba.data(),
+        BOARD_WIDTH * 4);
+    SDL_SetRenderTarget(renderer, previousTarget);
+    app->mGLInterface->UpdateViewport();
+    if (readResult != 0)
+        return "";
+#else
+    SDL_GL_MakeCurrent(
+        static_cast<SDL_Window*>(app->mWindow),
+        static_cast<SDL_GLContext>(app->mContext));
+
+    static GLuint framebuffer = 0;
+    static GLuint texture = 0;
+    if (framebuffer == 0)
+    {
+        glGenTextures(1, &texture);
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexImage2D(
+            GL_TEXTURE_2D,
+            0,
+            GL_RGBA,
+            BOARD_WIDTH,
+            BOARD_HEIGHT,
+            0,
+            GL_RGBA,
+            GL_UNSIGNED_BYTE,
+            nullptr);
+        glGenFramebuffers(1, &framebuffer);
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glFramebufferTexture2D(
+            GL_FRAMEBUFFER,
+            GL_COLOR_ATTACHMENT0,
+            GL_TEXTURE_2D,
+            texture,
+            0);
+    }
+    else
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    }
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        return "";
+    }
+
+    glViewport(0, 0, BOARD_WIDTH, BOARD_HEIGHT);
+    glClear(GL_COLOR_BUFFER_BIT);
+    Graphics graphics(app->mGLInterface->GetScreenImage());
+    app->mBoard->Draw(&graphics);
+
+    glReadPixels(
+        0,
+        0,
+        BOARD_WIDTH,
+        BOARD_HEIGHT,
+        GL_RGBA,
+        GL_UNSIGNED_BYTE,
+        rgba.data());
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    app->mGLInterface->UpdateViewport();
+#endif
+
+    std::vector<unsigned char> rgb(static_cast<std::size_t>(outputWidth) * outputHeight * 3);
+    for (int y = 0; y < outputHeight; ++y)
+    {
+#if defined(PVZ_MACOS_METAL)
+        const int sourceY = y * BOARD_HEIGHT / outputHeight;
+#else
+        const int sourceY = BOARD_HEIGHT - 1 - y * BOARD_HEIGHT / outputHeight;
+#endif
+        for (int x = 0; x < outputWidth; ++x)
+        {
+            const int sourceX = x * BOARD_WIDTH / outputWidth;
+            const std::size_t sourceOffset =
+                (static_cast<std::size_t>(sourceY) * BOARD_WIDTH + sourceX) * 4;
+            const std::size_t offset = (static_cast<std::size_t>(y) * outputWidth + x) * 3;
+            rgb[offset] = rgba[sourceOffset];
+            rgb[offset + 1] = rgba[sourceOffset + 1];
+            rgb[offset + 2] = rgba[sourceOffset + 2];
+        }
+    }
+
+    std::ostringstream out;
+    out << ",\"frame\":{\"encoding\":\"rgb8-base64\""
+        << ",\"width\":" << outputWidth
+        << ",\"height\":" << outputHeight
+        << ",\"source_width\":" << BOARD_WIDTH
+        << ",\"source_height\":" << BOARD_HEIGHT
+        << ",\"data\":\"" << Base64Encode(rgb) << "\"}";
+    return out.str();
+}
