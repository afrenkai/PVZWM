+std::string ObservationJson(
+    LawnApp* app,
+    int action,
+    int ticks,
+    int healthBefore,
+    int frameWidth = 0,
+    int frameHeight = 0)
+{
+    Board* board = app->mBoard;
+    if (board == nullptr)
+        return "{\"ok\":false,\"error\":\"board unavailable\"}";
+
+    const int healthAfter = TotalZombieHealth(board);
+    const bool won = app->mBoardResult == BoardResult::BOARDRESULT_WON;
+    const bool lost = app->mBoardResult == BoardResult::BOARDRESULT_LOST;
+    const double reward = (healthBefore < 0 ? 0.0 : static_cast<double>(healthBefore - healthAfter) / 1000.0)
+        + (won ? 100.0 : 0.0) - (lost ? 100.0 : 0.0);
+
+    std::ostringstream out;
+    out << "{\"ok\":true"
+        << ",\"protocol_version\":4"
+        << ",\"action_count\":" << kActionCount
+        << ",\"logical_width\":" << BOARD_WIDTH
+        << ",\"logical_height\":" << BOARD_HEIGHT
+        << ",\"game_mode\":" << static_cast<int>(app->mGameMode)
+        << ",\"level\":" << board->mLevel
+        << ",\"area\":" << ((board->mLevel - 1) / LEVELS_PER_AREA + 1)
+        << ",\"stage\":" << ((board->mLevel - 1) % LEVELS_PER_AREA + 1)
+        << ",\"background\":" << static_cast<int>(board->mBackground)
+        << ",\"row_count\":" << (board->StageHas6Rows() ? 6 : 5)
+        << ",\"stage_is_night\":" << (board->StageIsNight() ? "true" : "false")
+        << ",\"stage_has_pool\":" << (board->StageHasPool() ? "true" : "false")
+        << ",\"stage_has_fog\":" << (board->StageHasFog() ? "true" : "false")
+        << ",\"stage_has_roof\":" << (board->StageHasRoof() ? "true" : "false")
+        << ",\"game_music_tune\":" << static_cast<int>(app->mMusic->GetGameMusicTune())
+        << ",\"has_conveyor\":" << (board->HasConveyorBeltSeedBank() ? "true" : "false")
+        << ",\"choose_seeds\":" << (board->ChooseSeedsOnCurrentLevel() ? "true" : "false")
+        << ",\"scene\":" << static_cast<int>(app->mGameScene)
+        << ",\"board_result\":" << static_cast<int>(app->mBoardResult)
+        << ",\"done\":" << ((won || lost) ? "true" : "false")
+        << ",\"won\":" << (won ? "true" : "false")
+        << ",\"reward\":" << reward
+        << ",\"last_action\":" << action
+        << ",\"ticks\":" << ticks
+        << ",\"app_rand_seed\":" << app->mAppRandSeed
+        << ",\"rand_seed\":" << app->mRandSeed
+        << ",\"rand_state_index\":" << RandStateIndex()
+        << ",\"sun\":" << board->mSunMoney
+        << ",\"wave\":" << board->mCurrentWave
+        << ",\"plants_count\":" << board->mPlants.mSize
+        << ",\"zombies_count\":" << ActiveZombieCount(board)
+        << ",\"coins_count\":" << ActiveCoinCount(board)
+        << ",\"main_counter\":" << board->mMainCounter
+        << ",\"tutorial_state\":" << static_cast<int>(board->mTutorialState)
+        << ",\"zombie_countdown\":" << board->mZombieCountDown
+        << ",\"num_waves\":" << board->mNumWaves
+        << ",\"total_spawned_waves\":" << board->mTotalSpawnedWaves
+        << ",\"challenge_state\":"
+        << static_cast<int>(board->mChallenge->mChallengeState)
+        << ",\"challenge_state_counter\":"
+        << board->mChallenge->mChallengeStateCounter
+        << ",\"survival_stage\":" << board->mChallenge->mSurvivalStage
+        << ",\"next_survival_stage_counter\":"
+        << board->mNextSurvivalStageCounter
+        << ",\"last_stand_button_visible\":"
+        << (board->mStoreButton != nullptr &&
+                !board->mStoreButton->mBtnNoDraw
+            ? "true"
+            : "false")
+        << ",\"last_stand_button_disabled\":"
+        << (board->mStoreButton == nullptr ||
+                board->mStoreButton->mDisabled
+            ? "true"
+            : "false")
+        << ",\"board_buttons_interactable\":"
+        << (board->CanInteractWithBoardButtons() ? "true" : "false")
+        << ",\"level_complete\":" << (board->mLevelComplete ? "true" : "false")
+        << ",\"zombie_health\":" << healthAfter
+        << ",\"mowers_ready\":" << board->CountUntriggerLawnMowers()
+        << ",\"mowers_triggered\":" << board->mTriggeredLawnMowers
+        << ",\"seed_bank_capacity\":" << board->mSeedBank->mNumPackets
+        << ",\"packet_upgrades\":"
+        << app->mPlayerInfo->mPurchases[StoreItem::STORE_ITEM_PACKET_UPGRADE];
+
+    out << ",\"available_seed_types\":[";
+    bool firstAvailableSeed = true;
+    for (int raw = static_cast<int>(SeedType::SEED_PEASHOOTER);
+         raw < static_cast<int>(SeedType::SEED_IMITATER);
+         ++raw)
+    {
+        if (!app->HasSeedType(static_cast<SeedType>(raw)))
+            continue;
+        if (!firstAvailableSeed)
+            out << ',';
+        firstAvailableSeed = false;
+        out << raw;
+    }
+    out << ']';
+
+    out << ",\"seed_packets\":[";
+    for (int slot = 0; slot < board->mSeedBank->mNumPackets; ++slot)
+    {
+        if (slot > 0)
+            out << ',';
+        SeedPacket& packet = board->mSeedBank->mSeedPackets[slot];
+        out << "{\"slot\":" << slot
+            << ",\"type\":" << static_cast<int>(packet.mPacketType)
+            << ",\"active\":" << (packet.mActive ? "true" : "false")
+            << ",\"refresh\":" << packet.mRefreshCounter << '}';
+    }
+    out << ']';
+
+    out << ",\"plants\":[";
+    bool first = true;
+    Plant* plant = nullptr;
+    while (board->IteratePlants(plant))
+    {
+        if (plant->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(plant->mSeedType)
+            << ",\"row\":" << plant->mRow
+            << ",\"col\":" << plant->mPlantCol
+            << ",\"x\":" << plant->mX
+            << ",\"y\":" << plant->mY
+            << ",\"health\":" << plant->mPlantHealth
+            << ",\"max_health\":" << plant->mPlantMaxHealth
+            << ",\"state\":" << static_cast<int>(plant->mState)
+            << ",\"state_countdown\":" << plant->mStateCountdown
+            << ",\"launch_counter\":" << plant->mLaunchCounter
+            << ",\"shooting_counter\":" << plant->mShootingCounter
+            << ",\"asleep\":" << (plant->mIsAsleep ? "true" : "false")
+            << ",\"squished\":" << (plant->mSquished ? "true" : "false") << '}';
+    }
+    out << ']';
+
+    out << ",\"zombies\":[";
+    first = true;
+    Zombie* zombie = nullptr;
+    while (board->IterateZombies(zombie))
+    {
+        if (zombie->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(zombie->mZombieType)
+            << ",\"row\":" << zombie->mRow
+            << ",\"x\":" << zombie->mPosX
+            << ",\"y\":" << zombie->mPosY
+            << ",\"velocity_x\":" << zombie->mVelX
+            << ",\"altitude\":" << zombie->mAltitude
+            << ",\"body_health\":" << zombie->mBodyHealth
+            << ",\"body_max_health\":" << zombie->mBodyMaxHealth
+            << ",\"helm_health\":" << zombie->mHelmHealth
+            << ",\"shield_health\":" << zombie->mShieldHealth
+            << ",\"phase\":" << static_cast<int>(zombie->mZombiePhase)
+            << ",\"phase_counter\":" << zombie->mPhaseCounter
+            << ",\"boss_mode\":" << zombie->mBossMode
+            << ",\"target_row\":" << zombie->mTargetRow
+            << ",\"boss_head_counter\":" << zombie->mBossHeadCounter
+            << ",\"fireball_row\":" << zombie->mFireballRow
+            << ",\"is_fireball\":" << (zombie->mIsFireBall ? "true" : "false")
+            << ",\"boss_ball_active\":"
+            << (
+                zombie->mBossFireBallReanimID
+                    != ReanimationID::REANIMATIONID_NULL
+                ? "true"
+                : "false")
+            << ",\"age\":" << zombie->mZombieAge
+            << ",\"from_wave\":" << zombie->mFromWave
+            << ",\"chilled_counter\":" << zombie->mChilledCounter
+            << ",\"buttered_counter\":" << zombie->mButteredCounter
+            << ",\"ice_trap_counter\":" << zombie->mIceTrapCounter
+            << ",\"eating\":" << (zombie->mIsEating ? "true" : "false")
+            << ",\"mind_controlled\":" << (zombie->mMindControlled ? "true" : "false")
+            << ",\"in_pool\":" << (zombie->mInPool ? "true" : "false") << '}';
+    }
+    out << ']';
+
+    out << ",\"projectiles\":[";
+    first = true;
+    Projectile* projectile = nullptr;
+    while (board->IterateProjectiles(projectile))
+    {
+        if (projectile->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(projectile->mProjectileType)
+            << ",\"row\":" << projectile->mRow
+            << ",\"x\":" << projectile->mPosX
+            << ",\"y\":" << projectile->mPosY
+            << ",\"z\":" << projectile->mPosZ
+            << ",\"velocity_x\":" << projectile->mVelX
+            << ",\"velocity_y\":" << projectile->mVelY
+            << ",\"velocity_z\":" << projectile->mVelZ
+            << ",\"motion\":" << static_cast<int>(projectile->mMotionType)
+            << ",\"age\":" << projectile->mProjectileAge
+            << ",\"damage_flags\":" << projectile->mDamageRangeFlags << '}';
+    }
+    out << ']';
+
+    out << ",\"coins\":[";
+    first = true;
+    Coin* coin = nullptr;
+    while (board->IterateCoins(coin))
+    {
+        if (coin->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(coin->mType)
+            << ",\"motion\":" << static_cast<int>(coin->mCoinMotion)
+            << ",\"x\":" << coin->mPosX
+            << ",\"y\":" << coin->mPosY
+            << ",\"velocity_x\":" << coin->mVelX
+            << ",\"velocity_y\":" << coin->mVelY
+            << ",\"age\":" << coin->mCoinAge
+            << ",\"being_collected\":" << (coin->mIsBeingCollected ? "true" : "false")
+            << ",\"hit_ground\":" << (coin->mHitGround ? "true" : "false") << '}';
+    }
+    out << ']';
+
+    out << ",\"grid_items\":[";
+    first = true;
+    GridItem* gridItem = nullptr;
+    while (board->IterateGridItems(gridItem))
+    {
+        if (gridItem->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"type\":" << static_cast<int>(gridItem->mGridItemType)
+            << ",\"state\":" << static_cast<int>(gridItem->mGridItemState)
+            << ",\"row\":" << gridItem->mGridY
+            << ",\"col\":" << gridItem->mGridX
+            << ",\"x\":" << gridItem->mPosX
+            << ",\"y\":" << gridItem->mPosY
+            << ",\"counter\":" << gridItem->mGridItemCounter
+            << ",\"zombie_type\":" << static_cast<int>(gridItem->mZombieType)
+            << ",\"seed_type\":" << static_cast<int>(gridItem->mSeedType) << '}';
+    }
+    out << ']';
+
+    out << ",\"mowers\":[";
+    first = true;
+    LawnMower* mower = nullptr;
+    while (board->IterateLawnMowers(mower))
+    {
+        if (mower->mDead)
+            continue;
+        if (!first)
+            out << ',';
+        first = false;
+        out << "{\"row\":" << mower->mRow
+            << ",\"state\":" << static_cast<int>(mower->mMowerState)
+            << ",\"type\":" << static_cast<int>(mower->mMowerType)
+            << ",\"x\":" << mower->mPosX
+            << ",\"visible\":" << (mower->mVisible ? "true" : "false") << '}';
+    }
+    out << ']';
+
+    out << ",\"available_interactions\":[";
+    bool firstInteraction = true;
+    if (LastStandStartAvailable(board))
+    {
+        out << "\"last_stand_start\"";
+        firstInteraction = false;
+    }
+    if (SurvivalRepickAvailable(board))
+    {
+        if (!firstInteraction)
+            out << ',';
+        out << "\"survival_repick\"";
+    }
+    out << ']';
+
+    out << ",\"legal_actions\":[";
+    const std::vector<int> legal = LegalActions(board);
+    for (std::size_t i = 0; i < legal.size(); ++i)
+    {
+        if (i > 0)
+            out << ',';
+        out << legal[i];
+    }
+    out << ']';
+    out << FrameJson(app, frameWidth, frameHeight);
+    out << '}';
+    return out.str();
+}
