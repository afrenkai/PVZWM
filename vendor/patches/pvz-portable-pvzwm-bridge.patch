+
+using namespace Sexy;
+
+namespace
+{
+
+SDL_Renderer* gRenderer = nullptr;
+SDL_BlendMode gBlendMode = SDL_BLENDMODE_BLEND;
+SDL_BlendMode gNormalBlendMode = SDL_BLENDMODE_BLEND;
+SDL_BlendMode gAdditiveBlendMode = SDL_BLENDMODE_ADD;
+bool gLinearFilter = false;
+int gMaxTextureWidth = 4096;
+int gMaxTextureHeight = 4096;
+bool gReportedGeometryError = false;
+// SDL rendering is confined to the main thread. Retaining these buffers avoids
+// heap traffic for every sprite/triangle submission and every texture tile.
+std::vector<SDL_Vertex> gGeometryVertices;
+std::vector<GLVertex> gTriangleVertices;
+std::vector<Uint8> gTextureUploadPixels;
+
+SDL_Color UnpackColor(uint32_t color)
+{
+	return SDL_Color{
+		static_cast<Uint8>(color & 0xff),
+		static_cast<Uint8>((color >> 8) & 0xff),
+		static_cast<Uint8>((color >> 16) & 0xff),
+		static_cast<Uint8>((color >> 24) & 0xff)
+	};
+}
+
+uint32_t VertexColor(uint32_t vertexColor, uint32_t fallback)
+{
+	return vertexColor ? ToLE32(
+		((vertexColor >> 16) & 0x000000ffu)
+		| (vertexColor & 0xff00ff00u)
+		| ((vertexColor << 16) & 0x00ff0000u))
+		: fallback;
+}
+
+void ConfigureTexture(SDL_Texture* texture)
+{
+	if (!texture)
+		return;
+	SDL_SetTextureBlendMode(texture, gBlendMode);
+	SDL_SetTextureScaleMode(
+		texture,
+		gLinearFilter ? SDL_ScaleModeLinear : SDL_ScaleModeNearest);
+}
+
+enum class Primitive
+{
+	Triangles,
+	TriangleStrip,
+	TriangleFan
+};
+
+void RenderVertices(
+	SDL_Texture* texture,
+	const GLVertex* vertices,
+	int vertexCount,
+	Primitive primitive)
+{
+	if (!gRenderer || !vertices || vertexCount < 3)
+		return;
+
+	gGeometryVertices.clear();
+	auto append = [&](const GLVertex& source)
+	{
+		SDL_Vertex vertex{};
+		vertex.position.x = source.sx;
+		vertex.position.y = source.sy;
+		vertex.color = UnpackColor(source.color);
+		vertex.tex_coord.x = source.tu;
+		vertex.tex_coord.y = source.tv;
+		gGeometryVertices.push_back(vertex);
+	};
+
+	switch (primitive)
+	{
+	case Primitive::Triangles:
+		gGeometryVertices.reserve(static_cast<size_t>(vertexCount));
+		for (int i = 0; i + 2 < vertexCount; i += 3)
+		{
+			append(vertices[i]);
+			append(vertices[i + 1]);
+			append(vertices[i + 2]);
+		}
+		break;
+	case Primitive::TriangleStrip:
+		gGeometryVertices.reserve(
+			static_cast<size_t>(vertexCount - 2) * 3);
+		for (int i = 0; i + 2 < vertexCount; ++i)
+		{
+			if ((i & 1) == 0)
+			{
+				append(vertices[i]);
+				append(vertices[i + 1]);
+			}
+			else
+			{
+				append(vertices[i + 1]);
+				append(vertices[i]);
+			}
+			append(vertices[i + 2]);
+		}
+		break;
+	case Primitive::TriangleFan:
+		gGeometryVertices.reserve(
+			static_cast<size_t>(vertexCount - 2) * 3);
+		for (int i = 1; i + 1 < vertexCount; ++i)
+		{
+			append(vertices[0]);
+			append(vertices[i]);
+			append(vertices[i + 1]);
+		}
+		break;
+	}
+
+	ConfigureTexture(texture);
+	if (SDL_RenderGeometry(
+			gRenderer,
+			texture,
+			gGeometryVertices.data(),
+			static_cast<int>(gGeometryVertices.size()),
+			nullptr,
+			0) != 0
+		&& !gReportedGeometryError)
+	{
+		gReportedGeometryError = true;
+		Sexy::LogError("Metal geometry submission failed: %s", SDL_GetError());
+	}
+}
+
+void RenderVertices(
+	SDL_Texture* texture,
+	const VertexList& vertices,
+	Primitive primitive)
+{
+	RenderVertices(texture, vertices.mVerts, vertices.mSize, primitive);
+}
+
+class ScopedClipRect
+{
+public:
+	explicit ScopedClipRect(const Rect* clip)
+	{
+		if (clip)
+		{
+			SDL_Rect rect{clip->mX, clip->mY, clip->mWidth, clip->mHeight};
+			SDL_RenderSetClipRect(gRenderer, &rect);
+		}
+	}
+
+	~ScopedClipRect()
+	{
+		SDL_RenderSetClipRect(gRenderer, nullptr);
+	}
+};
+
+float GetCoord(const GLVertex& vertex, int component)
+{
+	switch (component)
+	{
+	case 0: return vertex.sx;
+	case 1: return vertex.sy;
+	case 2: return vertex.sz;
+	case 3: return vertex.tu;
+	case 4: return vertex.tv;
+	default: return 0.0f;
+	}
+}
+
+GLVertex Interpolate(const GLVertex& a, const GLVertex& b, float t)
+{
+	GLVertex result = a;
+	result.sx = a.sx + t * (b.sx - a.sx);
+	result.sy = a.sy + t * (b.sy - a.sy);
+	result.tu = a.tu + t * (b.tu - a.tu);
+	result.tv = a.tv + t * (b.tv - a.tv);
+	if (a.color != b.color)
+	{
+		auto lerp = [&](int shift)
+		{
+			return static_cast<int>(
+				((a.color >> shift) & 0xff)
+				+ t * (
+					static_cast<int>((b.color >> shift) & 0xff)
+					- static_cast<int>((a.color >> shift) & 0xff)));
+		};
+		result.color = static_cast<uint32_t>(
+			lerp(0)
+			| (lerp(8) << 8)
+			| (lerp(16) << 16)
+			| (lerp(24) << 24));
+	}
+	return result;
+}
+
+template<class Predicate>
+struct PointClipper
+{
+	Predicate mPredicate;
+
+	void ClipPoint(
+		int component,
+		float clipValue,
+		const GLVertex& first,
+		const GLVertex& second,
+		VertexList& output)
+	{
+		bool firstOutside = mPredicate(GetCoord(first, component), clipValue);
+		bool secondOutside = mPredicate(GetCoord(second, component), clipValue);
+		if (!firstOutside)
+		{
+			if (!secondOutside)
+				output.push_back(second);
+			else
+				output.push_back(Interpolate(
+					first,
+					second,
+					(clipValue - GetCoord(first, component))
+						/ (GetCoord(second, component) - GetCoord(first, component))));
+		}
+		else if (!secondOutside)
+		{
+			output.push_back(Interpolate(
+				first,
+				second,
+				(clipValue - GetCoord(first, component))
+					/ (GetCoord(second, component) - GetCoord(first, component))));
+			output.push_back(second);
+		}
+	}
+
+	void ClipPoints(
+		int component,
+		float clipValue,
+		VertexList& input,
+		VertexList& output)
+	{
+		if (input.size() < 2)
+			return;
+		ClipPoint(component, clipValue, input[input.size() - 1], input[0], output);
+		for (int i = 0; i < input.size() - 1; ++i)
+			ClipPoint(component, clipValue, input[i], input[i + 1], output);
+	}
+};
+
+void ClipTextureCoordinates(VertexList& vertices)
+{
+	VertexList scratch;
+	VertexList* input = &vertices;
+	VertexList* output = &scratch;
+	PointClipper<std::less<float>> less;
+	PointClipper<std::greater_equal<float>> greaterEqual;
+
+	less.ClipPoints(3, 0, *input, *output);
+	std::swap(input, output);
+	output->clear();
+	less.ClipPoints(4, 0, *input, *output);
+	std::swap(input, output);
+	output->clear();
+	greaterEqual.ClipPoints(3, 1, *input, *output);
+	std::swap(input, output);
+	output->clear();
+	greaterEqual.ClipPoints(4, 1, *input, *output);
+
+	vertices = *output;
+}
+
+void UploadTexturePixels(
+	SDL_Texture* texture,
+	MemoryImage* image,
+	int offsetX,
+	int offsetY,
+	int width,
+	int height)
+{
+	gTextureUploadPixels.resize(static_cast<size_t>(width) * height * 4);
+	const auto* colorIndices =
+		static_cast<const uint8_t*>(image->mColorIndices);
+	const uint32_t* colorTable = image->mColorTable;
+	const uint32_t* sourceBits = colorTable ? nullptr : image->GetBits();
+	const int sourceWidth = image->GetWidth();
+	for (int y = 0; y < height; ++y)
+	{
+		for (int x = 0; x < width; ++x)
+		{
+			uint32_t argb;
+			if (colorTable)
+			{
+				argb = colorTable[
+					colorIndices[
+						(offsetY + y) * sourceWidth + offsetX + x]];
+			}
+			else
+			{
+				argb = sourceBits[
+					(offsetY + y) * sourceWidth + offsetX + x];
+			}
+
+			size_t destination = (static_cast<size_t>(y) * width + x) * 4;
+			gTextureUploadPixels[destination] =
+				static_cast<Uint8>((argb >> 16) & 0xff);
+			gTextureUploadPixels[destination + 1] =
+				static_cast<Uint8>((argb >> 8) & 0xff);
+			gTextureUploadPixels[destination + 2] =
+				static_cast<Uint8>(argb & 0xff);
+			gTextureUploadPixels[destination + 3] =
+				static_cast<Uint8>((argb >> 24) & 0xff);
+		}
+	}
+	SDL_UpdateTexture(
+		texture,
+		nullptr,
+		gTextureUploadPixels.data(),
+		width * 4);
+}
