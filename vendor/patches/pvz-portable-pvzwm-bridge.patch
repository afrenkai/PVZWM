+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#include "Resources.h"
+#include "Sexy.TodLib/TodCommon.h"
+#include "Sexy.TodLib/TodStringFile.h"
+#include "SexyAppFramework/graphics/Font.h"
+#include "SexyAppFramework/graphics/Graphics.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+using namespace Sexy;
+
+bool (*gAppCloseRequest)();
+bool (*gAppHasUsedCheatKeys)();
+std::string (*gGetCurrentLevelName)();
+
+namespace
+{
+struct DrawCall
+{
+	std::string mText;
+	Color mColor;
+	int mY;
+};
+
+class RecordingFont : public _Font
+{
+public:
+	std::vector<DrawCall> mDrawCalls;
+
+	RecordingFont()
+	{
+		mAscent = 8;
+		mAscentPadding = 0;
+		mHeight = 10;
+		mLineSpacingOffset = 2;
+	}
+
+	int StringWidth(std::string_view theString) override
+	{
+		return static_cast<int>(theString.size());
+	}
+
+	int CharWidth(char32_t) override
+	{
+		return 1;
+	}
+
+	int CharWidthKern(char32_t, char32_t) override
+	{
+		return 1;
+	}
+
+	void DrawString(
+		Graphics*,
+		int,
+		int theY,
+		std::string_view theString,
+		const Color& theColor,
+		const Rect&) override
+	{
+		if (!theString.empty())
+			mDrawCalls.push_back({ std::string(theString), theColor, theY });
+	}
+
+	_Font* Duplicate() override
+	{
+		return new RecordingFont(*this);
+	}
+};
+
+[[noreturn]] void Fail(int theWidth, const DrawCall& theCall)
+{
+	std::cerr
+		<< "width " << theWidth << " rendered hidden metal text \""
+		<< theCall.mText << "\" with alpha " << theCall.mColor.mAlpha << '\n';
+	std::exit(1);
+}
+
+void TestFormatTokensAfterWrapDoNotChangePreviousLineSpacing()
+{
+	RecordingFont aFont;
+	Graphics aGraphics;
+	aGraphics.mClipRect = Rect(-1000, -1000, 2000, 2000);
+	TodDrawStringWrappedHelper(
+		&aGraphics,
+		"one two three {SHORTLINE}four five",
+		Rect(0, 0, 13, 200),
+		&aFont,
+		Color(40, 50, 90),
+		DrawStringJustification::DS_ALIGN_LEFT,
+		true);
+
+	if (aFont.mDrawCalls.size() < 2 ||
+		aFont.mDrawCalls[0].mText != "one two three" ||
+		aFont.mDrawCalls[0].mY != 8 ||
+		aFont.mDrawCalls[1].mText != "four five" ||
+		aFont.mDrawCalls[1].mY != 20)
+	{
+		std::cerr << "format token after wrap changed the preceding line spacing\n";
+		std::exit(1);
+	}
+}
+}
+
+int main()
+{
+	TodStringListSetColors(gLawnStringFormats, gLawnStringFormatCount);
+	for (TodStringListFormat& aFormat : gLawnStringFormats)
+	{
+		if (TestBit(
+			aFormat.mFormatFlags,
+			TodStringFormatFlag::TOD_FORMAT_HIDE_UNTIL_MAGNETSHROOM))
+		{
+			aFormat.mNewColor.mAlpha = 0;
+			aFormat.mLineSpacingOffset = -17;
+		}
+	}
+
+	const std::string aDescription =
+		"{KEYWORD}Weakness:{STAT} fume-shroom{METAL} and magnet-shroom{KEYWORD}";
+	for (int aWidth = 13; aWidth <= 60; ++aWidth)
+	{
+		RecordingFont aFont;
+		Graphics aGraphics;
+		aGraphics.mClipRect = Rect(-1000, -1000, 2000, 2000);
+		TodDrawStringWrappedHelper(
+			&aGraphics,
+			aDescription,
+			Rect(0, 0, aWidth, 200),
+			&aFont,
+			Color(40, 50, 90),
+			DrawStringJustification::DS_ALIGN_LEFT,
+			true);
+
+		for (const DrawCall& aCall : aFont.mDrawCalls)
+		{
+			if (aCall.mText.find("magnet-shroom") != std::string::npos &&
+				aCall.mColor.mAlpha != 0)
+			{
+				Fail(aWidth, aCall);
+			}
+		}
+	}
+
+	TestFormatTokensAfterWrapDoNotChangePreviousLineSpacing();
+	std::cout << "TodStringFile wrapped-format regression passed\n";
+	return 0;
+}
