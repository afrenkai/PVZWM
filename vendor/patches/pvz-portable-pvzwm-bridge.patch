+TextureData::TextureData()
+	: mWidth(0),
+	  mHeight(0),
+	  mTexVecWidth(0),
+	  mTexVecHeight(0),
+	  mBitsChangedCount(0),
+	  mTexMemSize(0),
+	  mMaxTotalU(0),
+	  mMaxTotalV(0),
+	  mPixelFormat(PixelFormat_Unknown),
+	  mImageFlags(0)
+{
+	mTexPieceWidth = 64;
+	mTexPieceHeight = 64;
+}
+
+TextureData::~TextureData()
+{
+	ReleaseTextures();
+}
+
+void TextureData::ReleaseTextures()
+{
+	for (auto& piece : mTextures)
+	{
+		if (piece.mTexture)
+			SDL_DestroyTexture(piece.mTexture);
+		piece.mTexture = nullptr;
+	}
+	mTextures.clear();
+	mTexMemSize = 0;
+}
+
+void TextureData::CreateTextureDimensions(MemoryImage* image)
+{
+	mTexPieceWidth = std::max(1, std::min(image->GetWidth(), gMaxTextureWidth));
+	mTexPieceHeight = std::max(1, std::min(image->GetHeight(), gMaxTextureHeight));
+	mTexVecWidth = (image->GetWidth() + mTexPieceWidth - 1) / mTexPieceWidth;
+	mTexVecHeight = (image->GetHeight() + mTexPieceHeight - 1) / mTexPieceHeight;
+	mTextures.resize(static_cast<size_t>(mTexVecWidth) * mTexVecHeight);
+
+	for (int row = 0; row < mTexVecHeight; ++row)
+	{
+		for (int column = 0; column < mTexVecWidth; ++column)
+		{
+			TextureDataPiece& piece = mTextures[row * mTexVecWidth + column];
+			piece.mTexture = nullptr;
+			piece.mWidth = std::min(
+				mTexPieceWidth,
+				image->GetWidth() - column * mTexPieceWidth);
+			piece.mHeight = std::min(
+				mTexPieceHeight,
+				image->GetHeight() - row * mTexPieceHeight);
+		}
+	}
+
+	mMaxTotalU = image->GetWidth() / static_cast<float>(mTexPieceWidth);
+	mMaxTotalV = image->GetHeight() / static_cast<float>(mTexPieceHeight);
+}
+
+void TextureData::CreateTextures(MemoryImage* image)
+{
+	image->DeleteSWBuffers();
+	image->CommitBits();
+
+	bool recreate =
+		mWidth != image->mWidth
+		|| mHeight != image->mHeight
+		|| (image->mRenderFlags & RenderImageFlag_TextureMask) != mImageFlags
+		|| mTextures.empty();
+	if (recreate)
+	{
+		ReleaseTextures();
+		mImageFlags = image->mRenderFlags & RenderImageFlag_TextureMask;
+		CreateTextureDimensions(image);
+	}
+
+	const uint32_t* sourceBits = image->GetBits();
+	mCpuBits.assign(
+		sourceBits,
+		sourceBits + static_cast<size_t>(image->GetWidth()) * image->GetHeight());
+
+	for (int row = 0; row < mTexVecHeight; ++row)
+	{
+		for (int column = 0; column < mTexVecWidth; ++column)
+		{
+			TextureDataPiece& piece = mTextures[row * mTexVecWidth + column];
+			if (!piece.mTexture)
+			{
+				piece.mTexture = SDL_CreateTexture(
+					gRenderer,
+					SDL_PIXELFORMAT_RGBA32,
+					SDL_TEXTUREACCESS_STATIC,
+					piece.mWidth,
+					piece.mHeight);
+				if (!piece.mTexture)
+				continue;
+				mTexMemSize += piece.mWidth * piece.mHeight * 4;
+			}
+			UploadTexturePixels(
+				piece.mTexture,
+				image,
+				column * mTexPieceWidth,
+				row * mTexPieceHeight,
+				piece.mWidth,
+				piece.mHeight);
+		}
+	}
+
+	mWidth = image->mWidth;
+	mHeight = image->mHeight;
+	mBitsChangedCount = image->mBitsChangedCount;
+	mPixelFormat = PixelFormat_A8R8G8B8;
+}
+
+void TextureData::CheckCreateTextures(MemoryImage* image)
+{
+	if (mPixelFormat == PixelFormat_Unknown
+		|| image->mWidth != mWidth
+		|| image->mHeight != mHeight
+		|| image->mBitsChangedCount != mBitsChangedCount
+		|| (image->mRenderFlags & RenderImageFlag_TextureMask) != mImageFlags)
+	{
+		CreateTextures(image);
+	}
+}
+
+SexyRenderTexture& TextureData::GetTexture(
+	int x,
+	int y,
+	int& width,
+	int& height,
+	float& u1,
+	float& v1,
+	float& u2,
+	float& v2,
+	float* uvBounds)
+{
+	int textureX = x / mTexPieceWidth;
+	int textureY = y / mTexPieceHeight;
+	TextureDataPiece& piece = mTextures[textureY * mTexVecWidth + textureX];
+	int left = x % mTexPieceWidth;
+	int top = y % mTexPieceHeight;
+	int right = std::min(left + width, piece.mWidth);
+	int bottom = std::min(top + height, piece.mHeight);
+	width = right - left;
+	height = bottom - top;
+	u1 = left / static_cast<float>(piece.mWidth);
+	v1 = top / static_cast<float>(piece.mHeight);
+	u2 = right / static_cast<float>(piece.mWidth);
+	v2 = bottom / static_cast<float>(piece.mHeight);
+	if (uvBounds)
+	{
+		uvBounds[0] = u1;
+		uvBounds[1] = v1;
+		uvBounds[2] = u2;
+		uvBounds[3] = v2;
+	}
+	return piece.mTexture;
+}
+
+SexyRenderTexture& TextureData::GetTextureF(
+	float x,
+	float y,
+	float& width,
+	float& height,
+	float& u1,
+	float& v1,
+	float& u2,
+	float& v2,
+	float* uvBounds)
+{
+	int textureX = static_cast<int>(x / mTexPieceWidth);
+	int textureY = static_cast<int>(y / mTexPieceHeight);
+	TextureDataPiece& piece = mTextures[textureY * mTexVecWidth + textureX];
+	float left = x - textureX * mTexPieceWidth;
+	float top = y - textureY * mTexPieceHeight;
+	float right = std::min(left + width, static_cast<float>(piece.mWidth));
+	float bottom = std::min(top + height, static_cast<float>(piece.mHeight));
+	width = right - left;
+	height = bottom - top;
+	u1 = left / piece.mWidth;
+	v1 = top / piece.mHeight;
+	u2 = right / piece.mWidth;
+	v2 = bottom / piece.mHeight;
+	if (uvBounds)
+	{
+		uvBounds[0] = u1;
+		uvBounds[1] = v1;
+		uvBounds[2] = u2;
+		uvBounds[3] = v2;
+	}
+	return piece.mTexture;
+}
+
+void TextureData::Blt(
+	float destinationX,
+	float destinationY,
+	const Rect& sourceRect,
+	const Color& color)
+{
+	int sourceRight = sourceRect.mX + sourceRect.mWidth;
+	int sourceBottom = sourceRect.mY + sourceRect.mHeight;
+	uint32_t packedColor = color.ToGLColor();
+
+	float y = destinationY;
+	for (int sourceY = sourceRect.mY; sourceY < sourceBottom;)
+	{
+		float x = destinationX;
+		int rowHeight = sourceBottom - sourceY;
+		for (int sourceX = sourceRect.mX; sourceX < sourceRight;)
+		{
+			int width = sourceRight - sourceX;
+			int height = rowHeight;
+			float u1, v1, u2, v2;
+			float uvBounds[4];
+			SDL_Texture* texture = GetTexture(
+				sourceX,
+				sourceY,
+				width,
+				height,
+				u1,
+				v1,
+				u2,
+				v2,
+				uvBounds);
+			GLVertex vertices[4] = {
+				{x, y, 0, packedColor, u1, v1},
+				{x, y + height, 0, packedColor, u1, v2},
+				{x + width, y, 0, packedColor, u2, v1},
+				{x + width, y + height, 0, packedColor, u2, v2}
+			};
+			RenderVertices(texture, vertices, 4, Primitive::TriangleStrip);
+			sourceX += width;
+			x += width;
+			rowHeight = height;
+		}
+		sourceY += rowHeight;
+		y += rowHeight;
+	}
+}
+
+void TextureData::BltTransformed(
+	const SexyMatrix3& transform,
+	const Rect& sourceRect,
+	const Color& color,
+	const Rect* clipRect,
+	float destinationX,
+	float destinationY,
+	bool center)
+{
+	int sourceRight = sourceRect.mX + sourceRect.mWidth;
+	int sourceBottom = sourceRect.mY + sourceRect.mHeight;
+	float startX = center ? -sourceRect.mWidth / 2.0f : 0.0f;
+	float startY = center ? -sourceRect.mHeight / 2.0f : 0.0f;
+	uint32_t packedColor = color.ToGLColor();
+	ScopedClipRect clip(clipRect);
+
+	float y = startY;
+	for (int sourceY = sourceRect.mY; sourceY < sourceBottom;)
+	{
+		float x = startX;
+		int rowHeight = sourceBottom - sourceY;
+		for (int sourceX = sourceRect.mX; sourceX < sourceRight;)
+		{
+			int width = sourceRight - sourceX;
+			int height = rowHeight;
+			float u1, v1, u2, v2;
+			float uvBounds[4];
+			SDL_Texture* texture = GetTexture(
+				sourceX,
+				sourceY,
+				width,
+				height,
+				u1,
+				v1,
+				u2,
+				v2,
+				uvBounds);
+			SexyVector2 points[4] = {
+				{x, y},
+				{x, y + height},
+				{x + width, y},
+				{x + width, y + height}
+			};
+			for (auto& point : points)
+			{
+				point = transform * point;
+				point.x += destinationX;
+				point.y += destinationY;
+			}
+			GLVertex vertices[4] = {
+				{points[0].x, points[0].y, 0, packedColor, u1, v1},
+				{points[1].x, points[1].y, 0, packedColor, u1, v2},
+				{points[2].x, points[2].y, 0, packedColor, u2, v1},
+				{points[3].x, points[3].y, 0, packedColor, u2, v2}
+			};
+			RenderVertices(texture, vertices, 4, Primitive::TriangleStrip);
+			sourceX += width;
+			x += width;
+			rowHeight = height;
+		}
+		sourceY += rowHeight;
+		y += rowHeight;
+	}
+}
+
+void TextureData::BltTriangles(
+	const TriVertex vertices[][3],
+	int triangleCount,
+	unsigned int color,
+	float translateX,
+	float translateY,
+	bool clampUv)
+{
+	if (triangleCount <= 0 || mTextures.empty())
+		return;
+
+	bool repeat = !clampUv;
+	bool singleTexture = mTexVecWidth == 1 && mTexVecHeight == 1;
+	if (singleTexture && !repeat)
+	{
+		gTriangleVertices.resize(static_cast<size_t>(triangleCount) * 3);
+		for (int triangle = 0; triangle < triangleCount; ++triangle)
+		{
+			for (int index = 0; index < 3; ++index)
+			{
+				const TriVertex& source = vertices[triangle][index];
+				gTriangleVertices[triangle * 3 + index] = {
+					source.x + translateX,
+					source.y + translateY,
+					0,
+					VertexColor(source.color, color),
+					source.u * mMaxTotalU,
+					source.v * mMaxTotalV
+				};
+			}
+		}
+		RenderVertices(
+			mTextures[0].mTexture,
+			gTriangleVertices.data(),
+			static_cast<int>(gTriangleVertices.size()),
+			Primitive::Triangles);
+		return;
+	}
+
+	for (int triangle = 0; triangle < triangleCount; ++triangle)
+	{
+		VertexList master;
+		for (int index = 0; index < 3; ++index)
+		{
+			const TriVertex& source = vertices[triangle][index];
+			master.push_back({
+				source.x + translateX,
+				source.y + translateY,
+				0,
+				VertexColor(source.color, color),
+				source.u * mMaxTotalU,
+				source.v * mMaxTotalV
+			});
+		}
+
+		float minimumU = std::numeric_limits<float>::max();
+		float minimumV = std::numeric_limits<float>::max();
+		float maximumU = std::numeric_limits<float>::lowest();
+		float maximumV = std::numeric_limits<float>::lowest();
+		for (int index = 0; index < 3; ++index)
+		{
+			minimumU = std::min(minimumU, master[index].tu);
+			minimumV = std::min(minimumV, master[index].tv);
+			maximumU = std::max(maximumU, master[index].tu);
+			maximumV = std::max(maximumV, master[index].tv);
+		}
+
+		int left = static_cast<int>(std::floor(minimumU));
+		int top = static_cast<int>(std::floor(minimumV));
+		int right = static_cast<int>(std::ceil(maximumU));
+		int bottom = static_cast<int>(std::ceil(maximumV));
+		if (!repeat)
+		{
+			left = std::max(0, left);
+			top = std::max(0, top);
+			right = std::min(mTexVecWidth, right);
+			bottom = std::min(mTexVecHeight, bottom);
+		}
+
+		for (int textureY = top; textureY < bottom; ++textureY)
+		{
+			for (int textureX = left; textureX < right; ++textureX)
+			{
+				int sourceTextureX = repeat ? 0 : textureX;
+				int sourceTextureY = repeat ? 0 : textureY;
+				if (sourceTextureX < 0 || sourceTextureX >= mTexVecWidth
+					|| sourceTextureY < 0 || sourceTextureY >= mTexVecHeight)
+					continue;
+
+				TextureDataPiece& piece =
+					mTextures[sourceTextureY * mTexVecWidth + sourceTextureX];
+				VertexList clipped = master;
+				for (int index = 0; index < clipped.size(); ++index)
+				{
+					clipped[index].tu -= textureX;
+					clipped[index].tv -= textureY;
+					if (!repeat)
+					{
+						clipped[index].tu *=
+							static_cast<float>(mTexPieceWidth) / piece.mWidth;
+						clipped[index].tv *=
+							static_cast<float>(mTexPieceHeight) / piece.mHeight;
+					}
+				}
+				ClipTextureCoordinates(clipped);
+				if (clipped.size() >= 3)
+				{
+					RenderVertices(
+						piece.mTexture,
+						clipped,
+						Primitive::TriangleFan);
+				}
+			}
+		}
+	}
+}
