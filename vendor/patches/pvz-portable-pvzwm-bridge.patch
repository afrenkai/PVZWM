+constexpr int kRows = 6;
+constexpr int kCols = 9;
+constexpr int kCells = kRows * kCols;
+constexpr int kSeedSlots = SEEDBANK_MAX;
+constexpr int kWaitAction = 0;
+constexpr int kPlantActionBegin = 1;
+constexpr int kShovelActionBegin = kPlantActionBegin + kSeedSlots * kCells;
+constexpr int kBoardClickActionBegin = kShovelActionBegin + kCells;
+constexpr int kCollectAction = kBoardClickActionBegin + kCells;
+constexpr int kActionCount = kCollectAction + 1;
