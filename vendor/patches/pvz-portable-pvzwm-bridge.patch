+std::string FrameJson(LawnApp* app, int outputWidth, int outputHeight)
+{
+    if (outputWidth <= 0 || outputHeight <= 0)
+        return "";
+
+    outputWidth = std::clamp(outputWidth, 1, BOARD_WIDTH);
+    outputHeight = std::clamp(outputHeight, 1, BOARD_HEIGHT);
+    SDL_GL_MakeCurrent(
+        static_cast<SDL_Window*>(app->mWindow),
+        static_cast<SDL_GLContext>(app->mContext));
+
+    static GLuint framebuffer = 0;
+    static GLuint texture = 0;
+    if (framebuffer == 0)
+    {
+        glGenTextures(1, &texture);
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexImage2D(
+            GL_TEXTURE_2D,
+            0,
+            GL_RGBA,
+            BOARD_WIDTH,
+            BOARD_HEIGHT,
+            0,
+            GL_RGBA,
+            GL_UNSIGNED_BYTE,
+            nullptr);
+        glGenFramebuffers(1, &framebuffer);
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glFramebufferTexture2D(
+            GL_FRAMEBUFFER,
+            GL_COLOR_ATTACHMENT0,
+            GL_TEXTURE_2D,
+            texture,
+            0);
+    }
+    else
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    }
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        return "";
+    }
+
+    glViewport(0, 0, BOARD_WIDTH, BOARD_HEIGHT);
+    glClear(GL_COLOR_BUFFER_BIT);
+    Graphics graphics(app->mGLInterface->GetScreenImage());
+    app->mBoard->Draw(&graphics);
+
+    std::vector<unsigned char> rgba(
+        static_cast<std::size_t>(BOARD_WIDTH) * BOARD_HEIGHT * 4);
+    glReadPixels(
+        0,
+        0,
+        BOARD_WIDTH,
+        BOARD_HEIGHT,
+        GL_RGBA,
+        GL_UNSIGNED_BYTE,
+        rgba.data());
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    app->mGLInterface->UpdateViewport();
+
+    std::vector<unsigned char> rgb(static_cast<std::size_t>(outputWidth) * outputHeight * 3);
+    for (int y = 0; y < outputHeight; ++y)
+    {
+        const int sourceY = BOARD_HEIGHT - 1 - y * BOARD_HEIGHT / outputHeight;
+        for (int x = 0; x < outputWidth; ++x)
+        {
+            const int sourceX = x * BOARD_WIDTH / outputWidth;
+            const std::size_t sourceOffset =
+                (static_cast<std::size_t>(sourceY) * BOARD_WIDTH + sourceX) * 4;
+            const std::size_t offset = (static_cast<std::size_t>(y) * outputWidth + x) * 3;
+            rgb[offset] = rgba[sourceOffset];
+            rgb[offset + 1] = rgba[sourceOffset + 1];
+            rgb[offset + 2] = rgba[sourceOffset + 2];
+        }
+    }
+
+    std::ostringstream out;
+    out << ",\"frame\":{\"encoding\":\"rgb8-base64\""
+        << ",\"width\":" << outputWidth
+        << ",\"height\":" << outputHeight
+        << ",\"source_width\":" << BOARD_WIDTH
+        << ",\"source_height\":" << BOARD_HEIGHT
+        << ",\"data\":\"" << Base64Encode(rgb) << "\"}";
+    return out.str();
+}
+
+std::optional<int> JsonInt(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find(':', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    ++pos;
+    while (pos < line.size() && std::isspace(static_cast<unsigned char>(line[pos])))
+        ++pos;
+    std::size_t end = pos;
+    if (end < line.size() && (line[end] == '-' || line[end] == '+'))
+        ++end;
+    while (end < line.size() && std::isdigit(static_cast<unsigned char>(line[end])))
+        ++end;
+    if (end == pos)
+        return std::nullopt;
+    return std::stoi(std::string(line.substr(pos, end - pos)));
+}
+
+std::optional<std::vector<int>> JsonIntArray(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find('[', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    const std::size_t close = line.find(']', pos + 1);
+    if (close == std::string_view::npos)
+        return std::nullopt;
+
+    std::vector<int> values;
+    ++pos;
+    while (pos < close)
+    {
+        while (pos < close && (std::isspace(static_cast<unsigned char>(line[pos])) || line[pos] == ','))
+            ++pos;
+        if (pos >= close)
+            break;
+        std::size_t end = pos;
+        if (line[end] == '-' || line[end] == '+')
+            ++end;
+        while (end < close && std::isdigit(static_cast<unsigned char>(line[end])))
+            ++end;
+        if (end == pos || (end == pos + 1 && (line[pos] == '-' || line[pos] == '+')))
+            return std::nullopt;
+        values.push_back(std::stoi(std::string(line.substr(pos, end - pos))));
+        pos = end;
+    }
+    return values;
+}
+
+std::optional<std::string> JsonString(std::string_view line, std::string_view key)
+{
+    const std::string quotedKey = "\"" + std::string(key) + "\"";
+    std::size_t pos = line.find(quotedKey);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find(':', pos + quotedKey.size());
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    pos = line.find('"', pos + 1);
+    if (pos == std::string_view::npos)
+        return std::nullopt;
+    const std::size_t end = line.find('"', pos + 1);
+    if (end == std::string_view::npos)
+        return std::nullopt;
+    return std::string(line.substr(pos + 1, end - pos - 1));
+}
