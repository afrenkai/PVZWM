+int main(int argc, char** argv)
+{
+    TodStringListSetColors(gLawnStringFormats, gLawnStringFormatCount);
+    gGetCurrentLevelName = LawnGetCurrentLevelName;
+    gAppCloseRequest = LawnGetCloseRequest;
+    gAppHasUsedCheatKeys = LawnHasUsedCheatKeys;
+    gExtractResourcesByName = Sexy::ExtractResourcesByName;
+
+    gLawnApp = new LawnApp();
+    gLawnApp->SetArgs(argc, argv);
+    gLawnApp->Init();
+    if (gLawnApp->mShutdown)
+    {
+        ProtocolLine("{\"ok\":false,\"error\":\"engine initialization failed\"}");
+        return 1;
+    }
+
+    gLawnApp->LoadingThreadProc();
+    if (gLawnApp->mPlayerInfo == nullptr)
+        gLawnApp->mPlayerInfo = gLawnApp->mProfileMgr->AddProfile("pvzwm");
+    gLawnApp->mLoadingThreadCompleted = true;
+    gLawnApp->mLoaded = true;
+
+    ProtocolLine("{\"ok\":true,\"ready\":true,\"protocol_version\":3,\"action_count\":" + std::to_string(kActionCount) + "}");
+
+    std::string line;
+    while (std::getline(std::cin, line))
+    {
+        const std::string command = JsonString(line, "cmd").value_or("");
+        if (command == "ping")
+        {
+            ProtocolLine("{\"ok\":true,\"pong\":true}");
+        }
+        else if (command == "reset")
+        {
+            const int level = JsonInt(line, "level").value_or(1);
+            const int seed = JsonInt(line, "seed").value_or(0);
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            const bool disableMowers = JsonInt(line, "disable_mowers").value_or(0) != 0;
+            const std::optional<std::vector<int>> seedTypes = JsonIntArray(line, "seed_types");
+            if (line.find("\"seed_types\"") != std::string::npos && !seedTypes.has_value())
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"invalid seed_types\"}");
+                continue;
+            }
+            if (!ResetLevel(gLawnApp, level, seed, disableMowers, seedTypes))
+                ProtocolLine("{\"ok\":false,\"error\":\"reset failed\"}");
+            else
+                ProtocolLine(ObservationJson(gLawnApp, kWaitAction, 1, -1, frameWidth, frameHeight));
+        }
+        else if (command == "step")
+        {
+            if (gLawnApp->mBoard == nullptr)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"reset required\"}");
+                continue;
+            }
+            const int action = JsonInt(line, "action").value_or(kWaitAction);
+            const int ticks = std::clamp(JsonInt(line, "ticks").value_or(1), 1, 10000);
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            int previousHealth = TotalZombieHealth(gLawnApp->mBoard);
+            int damageDealt = 0;
+            ApplyAction(gLawnApp->mBoard, action);
+            int currentHealth = TotalZombieHealth(gLawnApp->mBoard);
+            damageDealt += std::max(0, previousHealth - currentHealth);
+            for (int i = 0; i < ticks; ++i)
+            {
+                previousHealth = currentHealth;
+                UpdateEngineTick(gLawnApp);
+                currentHealth = TotalZombieHealth(gLawnApp->mBoard);
+                damageDealt += std::max(0, previousHealth - currentHealth);
+                if (gLawnApp->mBoardResult == BoardResult::BOARDRESULT_WON ||
+                    gLawnApp->mBoardResult == BoardResult::BOARDRESULT_LOST)
+                    break;
+            }
+            gLawnApp->mBoard->ProcessDeleteQueue();
+            const int rewardHealthBefore = TotalZombieHealth(gLawnApp->mBoard) + damageDealt;
+            ProtocolLine(ObservationJson(gLawnApp, action, ticks, rewardHealthBefore, frameWidth, frameHeight));
+        }
+        else if (command == "observe")
+        {
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            ProtocolLine(ObservationJson(gLawnApp, kWaitAction, 0, -1, frameWidth, frameHeight));
+        }
+        else if (command == "quit")
+        {
+            ProtocolLine("{\"ok\":true,\"bye\":true}");
+            break;
+        }
+        else
+        {
+            ProtocolLine("{\"ok\":false,\"error\":\"unknown command\"}");
+        }
+    }
+
+    gLawnApp->Shutdown();
+    delete gLawnApp;
+    return 0;
+}
