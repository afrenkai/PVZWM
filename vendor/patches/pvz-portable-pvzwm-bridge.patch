+static bool IsPathWithin(const std::filesystem::path& thePath, const std::filesystem::path& theParent)
+{
+	auto aPathIt = thePath.begin();
+	for (auto aParentIt = theParent.begin(); aParentIt != theParent.end(); ++aParentIt, ++aPathIt)
+	{
+		if (aPathIt == thePath.end() || *aPathIt != *aParentIt)
+			return false;
+	}
+	return true;
+}
+
+bool LawnApp::IsTeacherSession() const
+{
+	return !mTeacherSessionDir.empty() && (mRecordingDemoBuffer || mPlayingDemoBuffer);
+}
+
+bool LawnApp::IsTeacherDoubleSpeed() const
+{
+	return mUpdateMultiplier == 2.0;
+}
+
+void LawnApp::ToggleTeacherDoubleSpeed()
+{
+	if (IsTeacherSession())
+		mUpdateMultiplier = IsTeacherDoubleSpeed() ? 1.0 : 2.0;
+}
+
+bool LawnApp::CanSaveTeacherCheckpoint() const
+{
+	return IsTeacherSession() &&
+		mTeacherCompletedLevel >= 1 && mTeacherCompletedLevel <= FINAL_LEVEL;
+}
+
+bool LawnApp::SaveTeacherCheckpoint()
+{
+	if (!CanSaveTeacherCheckpoint())
+		return false;
+
+	WriteCurrentUserConfig();
+	WriteToRegistry();
+
+	// Reproduce the synchronous save calls recorded by the teacher button, but
+	// never emit a second checkpoint while verifying a playback.
+	if (mPlayingDemoBuffer)
+		return true;
+
+	const int aWorld = (mTeacherCompletedLevel - 1) / LEVELS_PER_AREA + 1;
+	const int aStage = (mTeacherCompletedLevel - 1) % LEVELS_PER_AREA + 1;
+	const std::string aBoundary = StrFormat("after-%d-%d", aWorld, aStage);
+	const std::string aMarker = "pvzwm/checkpoint/" + aBoundary;
+	DemoAddMarker(aMarker);
+	WriteDemoBuffer();
+
+	std::error_code anError;
+	const std::filesystem::path aSaveDir =
+		std::filesystem::weakly_canonical(PathFromU8(GetAppDataFolder()), anError);
+	if (anError)
+		return false;
+	const std::filesystem::path aSessionDir =
+		std::filesystem::weakly_canonical(PathFromU8(mTeacherSessionDir), anError);
+	if (anError || aSaveDir == aSessionDir ||
+		IsPathWithin(aSessionDir, aSaveDir) || IsPathWithin(aSaveDir, aSessionDir))
+		return false;
+
+	const std::filesystem::path aCheckpointRoot = aSessionDir / "checkpoints";
+	std::filesystem::create_directories(aCheckpointRoot, anError);
+	if (anError)
+		return false;
+
+	const std::filesystem::path aDestination = aCheckpointRoot / PathFromU8(aBoundary);
+	const std::filesystem::path aTemporary = aCheckpointRoot / PathFromU8("." + aBoundary + ".tmp");
+	if (std::filesystem::exists(aDestination, anError) || std::filesystem::exists(aTemporary, anError) || anError)
+		return false;
+
+	std::filesystem::copy(
+		aSaveDir,
+		aTemporary,
+		std::filesystem::copy_options::recursive | std::filesystem::copy_options::copy_symlinks,
+		anError);
+	if (anError)
+	{
+		std::error_code aCleanupError;
+		std::filesystem::remove_all(aTemporary, aCleanupError);
+		return false;
+	}
+
+	std::ofstream aManifest(aTemporary / "pvzwm-checkpoint.json", std::ios::out | std::ios::trunc);
+	aManifest
+		<< "{\n"
+		<< "  \"schema_version\": 1,\n"
+		<< "  \"kind\": \"pvzwm-human-teacher-checkpoint\",\n"
+		<< "  \"completed_level\": " << mTeacherCompletedLevel << ",\n"
+		<< "  \"world\": " << aWorld << ",\n"
+		<< "  \"stage\": " << aStage << ",\n"
+		<< "  \"next_adventure_level\": " << mPlayerInfo->GetLevel() << ",\n"
+		<< "  \"demo_marker\": \"" << aMarker << "\",\n"
+		<< "  \"demo_update\": " << mUpdateCount << ",\n"
+		<< "  \"engine_version\": \"" << PVZP_VERSION << "\"\n"
+		<< "}\n";
+	aManifest.close();
+	if (!aManifest)
+	{
+		std::error_code aCleanupError;
+		std::filesystem::remove_all(aTemporary, aCleanupError);
+		return false;
+	}
+
+	std::filesystem::rename(aTemporary, aDestination, anError);
+	if (anError)
+	{
+		std::error_code aCleanupError;
+		std::filesystem::remove_all(aTemporary, aCleanupError);
+		return false;
+	}
+
+	std::ofstream anIndex(aSessionDir / "checkpoints.jsonl", std::ios::out | std::ios::app);
+	anIndex
+		<< "{\"schema_version\":1,\"completed_level\":" << mTeacherCompletedLevel
+		<< ",\"checkpoint\":\"checkpoints/" << aBoundary
+		<< "\",\"demo_marker\":\"" << aMarker
+		<< "\",\"demo_update\":" << mUpdateCount << "}\n";
+	anIndex.close();
+
+	TodTrace("Saved PVZWM teacher checkpoint after %d-%d to '%s'",
+		aWorld, aStage, PathToU8(aDestination).c_str());
+	return true;
+}
