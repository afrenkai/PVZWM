+void UpdateEngineTick(LawnApp* app)
+{
+    ++app->mAppCounter;
+    app->mBoard->ProcessDeleteQueue();
+    if (app->mLoadingThreadCompleted && app->mEffectSystem != nullptr)
+        app->mEffectSystem->ProcessDeleteQueue();
+    app->mBoard->Update();
+    app->mMusic->MusicUpdate();
+}
+
+bool PickSeeds(
+    LawnApp* app,
+    SeedChooserScreen* chooser,
+    const std::optional<std::vector<int>>& requestedSeeds,
+    std::string* error = nullptr)
+{
+    std::vector<SeedType> candidates;
+    Board* board = app->mBoard;
+    if (requestedSeeds.has_value())
+    {
+        if (static_cast<int>(requestedSeeds->size()) != board->mSeedBank->mNumPackets)
+        {
+            if (error != nullptr)
+            {
+                *error =
+                    "requested " +
+                    std::to_string(requestedSeeds->size()) +
+                    " seeds for " +
+                    std::to_string(board->mSeedBank->mNumPackets) +
+                    " bank slots";
+            }
+            return false;
+        }
+        for (int raw : *requestedSeeds)
+        {
+            if (raw < static_cast<int>(SeedType::SEED_PEASHOOTER) ||
+                raw >= static_cast<int>(SeedType::SEED_IMITATER))
+            {
+                if (error != nullptr)
+                    *error = "requested seed type is outside chooser range";
+                return false;
+            }
+            const SeedType seedType = static_cast<SeedType>(raw);
+            if (std::find(candidates.begin(), candidates.end(), seedType) != candidates.end())
+            {
+                if (error != nullptr)
+                    *error = "requested seed types contain a duplicate";
+                return false;
+            }
+            candidates.push_back(seedType);
+        }
+    }
+    else
+    {
+        if (board->StageHasRoof())
+            candidates.push_back(SeedType::SEED_FLOWERPOT);
+        if (board->StageHasPool())
+            candidates.push_back(SeedType::SEED_LILYPAD);
+        if (board->StageIsNight())
+        {
+            candidates.push_back(SeedType::SEED_SUNSHROOM);
+            candidates.push_back(SeedType::SEED_PUFFSHROOM);
+            candidates.push_back(SeedType::SEED_FUMESHROOM);
+            candidates.push_back(SeedType::SEED_GRAVEBUSTER);
+        }
+        else
+        {
+            candidates.push_back(SeedType::SEED_SUNFLOWER);
+            candidates.push_back(SeedType::SEED_PEASHOOTER);
+            candidates.push_back(SeedType::SEED_REPEATER);
+            candidates.push_back(SeedType::SEED_SNOWPEA);
+        }
+        candidates.insert(candidates.end(), {
+            SeedType::SEED_WALLNUT,
+            SeedType::SEED_POTATOMINE,
+            SeedType::SEED_CHERRYBOMB,
+            SeedType::SEED_SQUASH,
+            SeedType::SEED_JALAPENO,
+            SeedType::SEED_CABBAGEPULT,
+            SeedType::SEED_KERNELPULT,
+            SeedType::SEED_MELONPULT,
+            SeedType::SEED_TALLNUT,
+            SeedType::SEED_BLOVER,
+            SeedType::SEED_CACTUS,
+        });
+    }
+
+    const int targetCount = board->mSeedBank->mNumPackets;
+    if (requestedSeeds.has_value() && chooser->mSeedsInBank == targetCount)
+    {
+        bool matchesRequestedSeeds = true;
+        for (int slot = 0; slot < targetCount; ++slot)
+        {
+            if (static_cast<int>(chooser->FindSeedInBank(slot)) !=
+                (*requestedSeeds)[slot])
+            {
+                matchesRequestedSeeds = false;
+                break;
+            }
+        }
+        if (matchesRequestedSeeds)
+        {
+            chooser->CloseSeedChooser();
+            return true;
+        }
+    }
+
+    if (requestedSeeds.has_value() && chooser->mSeedsInBank > 0)
+    {
+        for (int raw = static_cast<int>(SeedType::SEED_PEASHOOTER);
+             raw < static_cast<int>(SeedType::NUM_SEEDS_IN_CHOOSER);
+             ++raw)
+        {
+            ChosenSeed& chosen =
+                chooser->mChosenSeeds[static_cast<SeedType>(raw)];
+            if (chosen.mSeedState != ChosenSeedState::SEED_IN_BANK &&
+                chosen.mSeedState != ChosenSeedState::SEED_FLYING_TO_BANK)
+                continue;
+            chooser->GetSeedPositionInChooser(raw, chosen.mX, chosen.mY);
+            chosen.mStartX = chosen.mX;
+            chosen.mStartY = chosen.mY;
+            chosen.mEndX = chosen.mX;
+            chosen.mEndY = chosen.mY;
+            chosen.mTimeStartMotion = 0;
+            chosen.mTimeEndMotion = 0;
+            chosen.mSeedState = ChosenSeedState::SEED_IN_CHOOSER;
+            chosen.mSeedIndexInBank = -1;
+        }
+        chooser->mSeedsInBank = 0;
+        chooser->mSeedsInFlight = 0;
+    }
+
+    auto choose = [&](SeedType seedType)
+    {
+        if (chooser->mSeedsInBank >= targetCount || !app->HasSeedType(seedType))
+            return false;
+        ChosenSeed& chosen = chooser->mChosenSeeds[seedType];
+        if (chosen.mSeedState != ChosenSeedState::SEED_IN_CHOOSER || chooser->SeedNotAllowedToPick(seedType))
+            return false;
+        const int slot = chooser->mSeedsInBank;
+        chosen.mTimeStartMotion = 0;
+        chosen.mTimeEndMotion = 0;
+        chosen.mStartX = chosen.mX;
+        chosen.mStartY = chosen.mY;
+        chooser->GetSeedPositionInBank(slot, chosen.mEndX, chosen.mEndY);
+        chosen.mX = chosen.mEndX;
+        chosen.mY = chosen.mEndY;
+        chosen.mSeedState = ChosenSeedState::SEED_IN_BANK;
+        chosen.mSeedIndexInBank = slot;
+        ++chooser->mSeedsInBank;
+        return true;
+    };
+
+    for (SeedType seedType : candidates)
+    {
+        if (!choose(seedType) && requestedSeeds.has_value())
+        {
+            if (error != nullptr)
+            {
+                const ChosenSeed& chosen = chooser->mChosenSeeds[seedType];
+                std::ostringstream message;
+                message << "seed " << static_cast<int>(seedType)
+                        << " rejected at slot " << chooser->mSeedsInBank
+                        << " with chooser state "
+                        << static_cast<int>(chosen.mSeedState)
+                        << ", available="
+                        << (app->HasSeedType(seedType) ? "true" : "false")
+                        << ", allowed="
+                        << (!chooser->SeedNotAllowedToPick(seedType)
+                            ? "true"
+                            : "false");
+                *error = message.str();
+            }
+            return false;
+        }
+    }
+    if (!requestedSeeds.has_value())
+    {
+        for (int raw = static_cast<int>(SeedType::SEED_PEASHOOTER);
+             raw < static_cast<int>(SeedType::NUM_SEEDS_IN_CHOOSER) && chooser->mSeedsInBank < targetCount;
+             ++raw)
+            choose(static_cast<SeedType>(raw));
+    }
+    if (chooser->mSeedsInBank != targetCount)
+    {
+        if (error != nullptr)
+        {
+            *error =
+                "seed chooser retained " +
+                std::to_string(chooser->mSeedsInBank) +
+                " of " +
+                std::to_string(targetCount) +
+                " requested packets";
+        }
+        return false;
+    }
+    chooser->CloseSeedChooser();
+    return true;
+}
+
+std::string ApplySurvivalRepick(
+    LawnApp* app,
+    const std::optional<std::vector<int>>& requestedSeeds)
+{
+    if (app->mBoard == nullptr || app->mPlayerInfo == nullptr ||
+        !SurvivalRepickAvailable(app->mBoard))
+        return "survival repick unavailable before transition";
+
+    const int savedProfileLevel = app->mPlayerInfo->GetLevel();
+    app->mPlayerInfo->SetLevel(FINAL_LEVEL);
+    app->CheckForGameEnd();
+    if (app->mBoard == nullptr || app->mSeedChooserScreen == nullptr)
+    {
+        app->mPlayerInfo->SetLevel(savedProfileLevel);
+        return "survival repick did not reach the seed chooser";
+    }
+
+    std::string selectionError;
+    const bool picked =
+        PickSeeds(
+            app,
+            app->mSeedChooserScreen,
+            requestedSeeds,
+            &selectionError);
+    app->mPlayerInfo->SetLevel(savedProfileLevel);
+    if (!picked)
+        return selectionError.empty()
+            ? "survival repick seed selection failed"
+            : selectionError;
+
+    app->mBoardResult = BoardResult::BOARDRESULT_NONE;
+    app->StartPlaying();
+    UpdateEngineTick(app);
+    return {};
+}
+
+bool ResetBoard(
+    LawnApp* app,
+    GameMode gameMode,
+    int level,
+    int seed,
+    bool disableMowers,
+    int packetUpgrades,
+    bool purchasedSeedUpgrades,
+    bool purchasedPoolCleaner,
+    bool purchasedRoofCleaner,
+    const std::optional<std::vector<int>>& requestedSeeds)
+{
+    if (app->mPlayerInfo == nullptr)
+        return false;
+    if (gameMode == GameMode::GAMEMODE_ADVENTURE &&
+        (level < 1 || level > FINAL_LEVEL))
+        return false;
+
+    const int savedProfileLevel = app->mPlayerInfo->GetLevel();
+    app->mPlayerInfo->SetLevel(
+        gameMode == GameMode::GAMEMODE_ADVENTURE ? level : FINAL_LEVEL);
+    // The bridge always runs against an isolated save directory.  Model the
+    // four packet-slot purchases explicitly so terminal verification can use
+    // any human-legal 6..10-slot GOTY profile without changing game rules.
+    app->mPlayerInfo->mPurchases[StoreItem::STORE_ITEM_PACKET_UPGRADE] =
+        static_cast<uint32_t>(packetUpgrades);
+    constexpr StoreItem seedUpgradePurchases[] = {
+        StoreItem::STORE_ITEM_PLANT_GATLINGPEA,
+        StoreItem::STORE_ITEM_PLANT_TWINSUNFLOWER,
+        StoreItem::STORE_ITEM_PLANT_GLOOMSHROOM,
+        StoreItem::STORE_ITEM_PLANT_CATTAIL,
+        StoreItem::STORE_ITEM_PLANT_WINTERMELON,
+        StoreItem::STORE_ITEM_PLANT_GOLD_MAGNET,
+        StoreItem::STORE_ITEM_PLANT_SPIKEROCK,
+        StoreItem::STORE_ITEM_PLANT_COBCANNON,
+    };
+    for (StoreItem purchase : seedUpgradePurchases)
+    {
+        app->mPlayerInfo->mPurchases[purchase] =
+            purchasedSeedUpgrades ? 1U : 0U;
+    }
+    app->mPlayerInfo->mPurchases[StoreItem::STORE_ITEM_POOL_CLEANER] =
+        purchasedPoolCleaner ? 1U : 0U;
+    app->mPlayerInfo->mPurchases[StoreItem::STORE_ITEM_ROOF_CLEANER] =
+        purchasedRoofCleaner ? 1U : 0U;
+    app->KillBoard();
+    // Board teardown can release effects that consume the global RNG. Seed
+    // only after the old board is gone so a reset depends on the requested
+    // seed, not on which level happened to run previously in this process.
+    app->mAppRandSeed = seed;
+    app->mRandSeed = static_cast<uint32_t>(seed);
+    SRand(static_cast<uint32_t>(seed));
+    std::srand(static_cast<unsigned int>(seed));
+    app->mGameMode = gameMode;
+    app->mMusic->mMusicDisabled = true;
+    app->mMuteSoundsForCutscene = true;
+    app->MakeNewBoard();
+    app->mBoard->InitLevel();
+    app->mBoard->mCutScene->PreloadResources();
+    app->mBoard->mCutScene->PlaceLawnItems();
+    app->mBoard->RemoveCutsceneZombies();
+    if (app->IsFinalBossLevel())
+        app->mBoard->mChallenge->PlayBossEnter();
+    app->mBoard->ProcessDeleteQueue();
+    app->mBoardResult = BoardResult::BOARDRESULT_NONE;
+    app->mGameScene = GameScenes::SCENE_LEVEL_INTRO;
+    app->ShowSeedChooserScreen();
+    if (app->mBoard == nullptr)
+    {
+        if (gameMode != GameMode::GAMEMODE_ADVENTURE)
+            app->mPlayerInfo->SetLevel(savedProfileLevel);
+        return false;
+    }
+
+    if (app->mSeedChooserScreen != nullptr && app->mBoard->ChooseSeedsOnCurrentLevel() &&
+        !PickSeeds(app, app->mSeedChooserScreen, requestedSeeds))
+    {
+        if (gameMode != GameMode::GAMEMODE_ADVENTURE)
+            app->mPlayerInfo->SetLevel(savedProfileLevel);
+        return false;
+    }
+    app->StartPlaying();
+    FinishSkippedCutsceneLawnMowers(app->mBoard);
+    UpdateEngineTick(app);
+    if (disableMowers)
+        RemoveAllMowers(app->mBoard);
+    if (gameMode != GameMode::GAMEMODE_ADVENTURE)
+        app->mPlayerInfo->SetLevel(savedProfileLevel);
+    return true;
+}
+
+bool ResetLevel(
+    LawnApp* app,
+    int level,
+    int seed,
+    bool disableMowers,
+    int packetUpgrades,
+    bool purchasedSeedUpgrades,
+    bool purchasedPoolCleaner,
+    bool purchasedRoofCleaner,
+    const std::optional<std::vector<int>>& requestedSeeds)
+{
+    return ResetBoard(
+        app,
+        GameMode::GAMEMODE_ADVENTURE,
+        level,
+        seed,
+        disableMowers,
+        packetUpgrades,
+        purchasedSeedUpgrades,
+        purchasedPoolCleaner,
+        purchasedRoofCleaner,
+        requestedSeeds);
+}
+
+bool ResetGameMode(
+    LawnApp* app,
+    int rawGameMode,
+    int seed,
+    bool disableMowers,
+    int packetUpgrades,
+    bool purchasedSeedUpgrades,
+    bool purchasedPoolCleaner,
+    bool purchasedRoofCleaner,
+    const std::optional<std::vector<int>>& requestedSeeds)
+{
+    if (rawGameMode < static_cast<int>(GameMode::GAMEMODE_SURVIVAL_NORMAL_STAGE_1) ||
+        rawGameMode >= static_cast<int>(GameMode::GAMEMODE_UPSELL))
+        return false;
+    return ResetBoard(
+        app,
+        static_cast<GameMode>(rawGameMode),
+        0,
+        seed,
+        disableMowers,
+        packetUpgrades,
+        purchasedSeedUpgrades,
+        purchasedPoolCleaner,
+        purchasedRoofCleaner,
+        requestedSeeds);
+}
+
+bool SaveCurrentBoard(LawnApp* app)
+{
+    if (app->mBoard == nullptr || app->mPlayerInfo == nullptr ||
+        !app->mBoard->NeedSaveGame())
+        return false;
+
+    app->mBoard->TryToSaveGame();
+    app->WriteCurrentUserConfig();
+    app->mProfileMgr->Save();
+    app->WriteToRegistry();
+    return app->FileExists(GetSavedGameName(app->mGameMode, app->mPlayerInfo->mId));
+}
+
+bool FlushCurrentProfile(LawnApp* app)
+{
+    if (app->mPlayerInfo == nullptr || app->mProfileMgr == nullptr)
+        return false;
+
+    app->WriteCurrentUserConfig();
+    app->mProfileMgr->Save();
+    app->WriteToRegistry();
+    return true;
+}
+
+bool LoadSavedBoard(LawnApp* app, int rawGameMode)
+{
+    if (app->mPlayerInfo == nullptr ||
+        rawGameMode < static_cast<int>(GameMode::GAMEMODE_ADVENTURE) ||
+        rawGameMode >= static_cast<int>(GameMode::GAMEMODE_UPSELL))
+        return false;
+
+    if (app->mBoard != nullptr)
+        app->KillBoard();
+    app->mGameMode = static_cast<GameMode>(rawGameMode);
+    app->mMusic->mMusicDisabled = true;
+    app->mMuteSoundsForCutscene = true;
+    if (!app->TryLoadGame() || app->mBoard == nullptr)
+        return false;
+
+    ContinueDialog* dialog = static_cast<ContinueDialog*>(
+        app->GetDialog(Dialogs::DIALOG_CONTINUE));
+    if (dialog == nullptr)
+        return false;
+    dialog->ButtonDepress(ContinueDialog::ContinueDialog_Continue);
+    return app->GetDialog(Dialogs::DIALOG_CONTINUE) == nullptr;
+}
+}
+
+int main(int argc, char** argv)
+{
+    TodStringListSetColors(gLawnStringFormats, gLawnStringFormatCount);
+    gGetCurrentLevelName = LawnGetCurrentLevelName;
+    gAppCloseRequest = LawnGetCloseRequest;
+    gAppHasUsedCheatKeys = LawnHasUsedCheatKeys;
+    gExtractResourcesByName = Sexy::ExtractResourcesByName;
+
+    gLawnApp = new LawnApp();
+    gLawnApp->SetArgs(argc, argv);
+    gLawnApp->Init();
+    if (gLawnApp->mShutdown)
+    {
+        ProtocolLine("{\"ok\":false,\"error\":\"engine initialization failed\"}");
+        return 1;
+    }
+
+    gLawnApp->LoadingThreadProc();
+    if (gLawnApp->mPlayerInfo == nullptr)
+        gLawnApp->mPlayerInfo = gLawnApp->mProfileMgr->AddProfile("pvzwm");
+    gLawnApp->mLoadingThreadCompleted = true;
+    gLawnApp->mLoaded = true;
+
+#if defined(PVZ_MACOS_METAL)
+    constexpr std::string_view rendererName = "metal";
+#else
+    constexpr std::string_view rendererName = "opengl";
+#endif
+    std::ostringstream ready;
+    ready << "{\"ok\":true,\"ready\":true,\"protocol_version\":4,\"renderer\":\""
+          << rendererName
+          << "\",\"action_count\":" << kActionCount
+          << ",\"profile_count\":" << gLawnApp->mProfileMgr->GetNumProfiles()
+          << ",\"profile\":";
+    if (gLawnApp->mPlayerInfo == nullptr)
+    {
+        ready << "null";
+    }
+    else
+    {
+        const PlayerInfo* profile = gLawnApp->mPlayerInfo;
+        ready << "{\"name\":\"" << JsonEscape(profile->mName)
+              << "\",\"id\":" << profile->mId
+              << ",\"adventure_level\":" << profile->GetLevel()
+              << ",\"coins\":" << profile->mCoins
+              << ",\"finished_adventure\":" << profile->mFinishedAdventure
+              << '}';
+    }
+    ready << '}';
+    ProtocolLine(ready.str());
+
+    std::string line;
+    while (std::getline(std::cin, line))
+    {
+        const std::string command = JsonString(line, "cmd").value_or("");
+        if (command == "ping")
+        {
+            ProtocolLine("{\"ok\":true,\"pong\":true}");
+        }
+        else if (command == "reset")
+        {
+            const std::optional<int> gameMode = JsonInt(line, "game_mode");
+            const int seed = JsonInt(line, "seed").value_or(0);
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            const bool disableMowers = JsonInt(line, "disable_mowers").value_or(0) != 0;
+            const int packetUpgrades =
+                JsonInt(line, "packet_upgrades").value_or(0);
+            const bool purchasedSeedUpgrades =
+                JsonInt(line, "purchased_seed_upgrades").value_or(0) != 0;
+            const bool purchasedPoolCleaner =
+                JsonInt(line, "purchased_pool_cleaner").value_or(0) != 0;
+            const bool purchasedRoofCleaner =
+                JsonInt(line, "purchased_roof_cleaner").value_or(0) != 0;
+            const std::optional<std::vector<int>> seedTypes = JsonIntArray(line, "seed_types");
+            if (line.find("\"seed_types\"") != std::string::npos && !seedTypes.has_value())
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"invalid seed_types\"}");
+                continue;
+            }
+            if (gameMode.has_value() && line.find("\"level\"") != std::string::npos)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"level and game_mode are mutually exclusive\"}");
+                continue;
+            }
+            if (packetUpgrades < 0 || packetUpgrades > 4)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"packet_upgrades must be in 0..4\"}");
+                continue;
+            }
+            const bool reset = gameMode.has_value()
+                ? ResetGameMode(
+                    gLawnApp,
+                    *gameMode,
+                    seed,
+                    disableMowers,
+                    packetUpgrades,
+                    purchasedSeedUpgrades,
+                    purchasedPoolCleaner,
+                    purchasedRoofCleaner,
+                    seedTypes)
+                : ResetLevel(
+                    gLawnApp,
+                    JsonInt(line, "level").value_or(1),
+                    seed,
+                    disableMowers,
+                    packetUpgrades,
+                    purchasedSeedUpgrades,
+                    purchasedPoolCleaner,
+                    purchasedRoofCleaner,
+                    seedTypes);
+            if (!reset)
+                ProtocolLine("{\"ok\":false,\"error\":\"reset failed\"}");
+            else
+                ProtocolLine(ObservationJson(gLawnApp, kWaitAction, 1, -1, frameWidth, frameHeight));
+        }
+        else if (command == "step")
+        {
+            if (gLawnApp->mBoard == nullptr)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"reset required\"}");
+                continue;
+            }
+            const int action = JsonInt(line, "action").value_or(kWaitAction);
+            const int ticks = std::clamp(JsonInt(line, "ticks").value_or(1), 1, 10000);
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            int previousHealth = TotalZombieHealth(gLawnApp->mBoard);
+            int damageDealt = 0;
+            ApplyAction(gLawnApp->mBoard, action);
+            int currentHealth = TotalZombieHealth(gLawnApp->mBoard);
+            damageDealt += std::max(0, previousHealth - currentHealth);
+            for (int i = 0; i < ticks; ++i)
+            {
+                previousHealth = currentHealth;
+                UpdateEngineTick(gLawnApp);
+                currentHealth = TotalZombieHealth(gLawnApp->mBoard);
+                damageDealt += std::max(0, previousHealth - currentHealth);
+                const bool intermediateSurvivalWin =
+                    gLawnApp->mBoardResult == BoardResult::BOARDRESULT_WON &&
+                    gLawnApp->mBoard->mApp->IsSurvivalMode() &&
+                    gLawnApp->mBoard->IsSurvivalStageWithRepick();
+                if ((!intermediateSurvivalWin &&
+                        gLawnApp->mBoardResult == BoardResult::BOARDRESULT_WON) ||
+                    gLawnApp->mBoardResult == BoardResult::BOARDRESULT_LOST)
+                    break;
+            }
+            gLawnApp->mBoard->ProcessDeleteQueue();
+            const int rewardHealthBefore = TotalZombieHealth(gLawnApp->mBoard) + damageDealt;
+            ProtocolLine(ObservationJson(gLawnApp, action, ticks, rewardHealthBefore, frameWidth, frameHeight));
+        }
+        else if (command == "interact")
+        {
+            if (gLawnApp->mBoard == nullptr)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"reset required\"}");
+                continue;
+            }
+            const std::string interaction =
+                JsonString(line, "interaction").value_or("");
+            const std::optional<std::vector<int>> seedTypes =
+                JsonIntArray(line, "seed_types");
+            if (line.find("\"seed_types\"") != std::string::npos &&
+                !seedTypes.has_value())
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"invalid seed_types\"}");
+                continue;
+            }
+            bool applied = false;
+            std::string interactionError;
+            if (interaction == "survival_repick")
+            {
+                interactionError =
+                    ApplySurvivalRepick(gLawnApp, seedTypes);
+                applied = interactionError.empty();
+            }
+            else
+            {
+                applied = ApplyInteraction(gLawnApp->mBoard, interaction);
+            }
+            if (!applied)
+            {
+                ProtocolLine(
+                    "{\"ok\":false,\"error\":\"" +
+                    JsonEscape(
+                        interactionError.empty()
+                            ? "interaction unavailable"
+                            : interactionError) +
+                    "\"}");
+                continue;
+            }
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            ProtocolLine(ObservationJson(
+                gLawnApp,
+                kWaitAction,
+                0,
+                -1,
+                frameWidth,
+                frameHeight));
+        }
+        else if (command == "observe")
+        {
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            ProtocolLine(ObservationJson(gLawnApp, kWaitAction, 0, -1, frameWidth, frameHeight));
+        }
+        else if (command == "save")
+        {
+            if (!SaveCurrentBoard(gLawnApp))
+                ProtocolLine("{\"ok\":false,\"error\":\"save failed\"}");
+            else
+                ProtocolLine("{\"ok\":true,\"saved\":true}");
+        }
+        else if (command == "finalize_win")
+        {
+            if (gLawnApp->mBoard == nullptr ||
+                gLawnApp->mBoardResult != BoardResult::BOARDRESULT_WON ||
+                !gLawnApp->mBoard->mLevelComplete)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"no completed win to finalize\"}");
+                continue;
+            }
+            const int completedLevel = gLawnApp->mBoard->mLevel;
+            gLawnApp->CheckForGameEnd();
+            if (gLawnApp->mPlayerInfo == nullptr)
+            {
+                ProtocolLine("{\"ok\":false,\"error\":\"win finalization lost profile\"}");
+                continue;
+            }
+            std::ostringstream finalized;
+            finalized
+                << "{\"ok\":true,\"win_finalized\":true"
+                << ",\"completed_level\":" << completedLevel
+                << ",\"adventure_level\":"
+                << gLawnApp->mPlayerInfo->GetLevel() << '}';
+            ProtocolLine(finalized.str());
+        }
+        else if (command == "flush_profile")
+        {
+            if (!FlushCurrentProfile(gLawnApp))
+                ProtocolLine("{\"ok\":false,\"error\":\"profile flush failed\"}");
+            else
+                ProtocolLine("{\"ok\":true,\"profile_flushed\":true}");
+        }
+        else if (command == "load")
+        {
+            const int frameWidth = JsonInt(line, "frame_width").value_or(0);
+            const int frameHeight = JsonInt(line, "frame_height").value_or(0);
+            if (!LoadSavedBoard(
+                    gLawnApp,
+                    JsonInt(line, "game_mode").value_or(
+                        static_cast<int>(GameMode::GAMEMODE_ADVENTURE))))
+                ProtocolLine("{\"ok\":false,\"error\":\"load failed\"}");
+            else
+                ProtocolLine(ObservationJson(
+                    gLawnApp,
+                    kWaitAction,
+                    0,
+                    -1,
+                    frameWidth,
+                    frameHeight));
+        }
+        else if (command == "quit")
+        {
+            ProtocolLine("{\"ok\":true,\"bye\":true}");
+            break;
+        }
+        else
+        {
+            ProtocolLine("{\"ok\":false,\"error\":\"unknown command\"}");
+        }
+    }
+
+    gLawnApp->Shutdown();
+    delete gLawnApp;
+    return 0;
+}
